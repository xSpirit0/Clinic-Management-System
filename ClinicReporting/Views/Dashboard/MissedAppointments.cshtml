@model ClinicReporting.Models.MissedAppointmentsReport
@{
    ViewData["Title"] = "Missed Appointments";
}

<div class="page-header">
    <h1>Missed Appointments</h1>
    <p>Appointments that were not attended by the patient</p>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mb-4"><i class="bi bi-exclamation-circle me-2"></i>@ViewBag.Error</div>
}


<div class="card mb-4">
    <div class="card-header"><i class="bi bi-funnel me-2"></i>Filter by Date Range</div>
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">From</label>
                <input type="date" name="from" class="form-control" value="@Model?.From" />
            </div>
            <div class="col-md-4">
                <label class="form-label">To</label>
                <input type="date" name="to" class="form-control" value="@Model?.To" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-1"></i> Apply Filter
                </button>
            </div>
        </form>
    </div>
</div>


<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card" style="border:1px solid var(--border);">
            <div style="position:absolute;top:0;left:0;width:4px;height:100%;background:#8b5cf6;border-radius:4px 0 0 4px;"></div>
            <div class="stat-num" style="color:#8b5cf6;">@(Model?.MissedAppointments?.Count ?? 0)</div>
            <div class="stat-lbl">Missed Appointments</div>
        </div>
    </div>
</div>


<div class="card">
    <div class="card-header"><i class="bi bi-calendar-x me-2"></i>Missed Appointment Records</div>
    <div class="card-body p-0">
        @if (Model?.MissedAppointments == null || !Model.MissedAppointments.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-check" style="font-size:2.5rem;color:var(--text-light);"></i>
                <p class="mt-3" style="color:var(--text-mid);">No missed appointments found for this period.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Specialization</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.MissedAppointments)
                        {
                            <tr>
                                <td style="color:var(--text-light);font-size:13px;">#@a.AppointmentId</td>
                                <td style="font-family:var(--font-display);font-weight:600;">@a.ScheduledDate</td>
                                <td style="font-size:13px;">@a.SlotStartTime — @a.SlotEndTime</td>
                                <td>@a.PatientName</td>
                                <td>Dr. @a.DoctorName</td>
                                <td><span class="badge bg-secondary">@a.Specialization</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
