@model ClinicReporting.Models.DoctorUtilizationReport
@{
    ViewData["Title"] = "Doctor Utilization";
}

<div class="page-header">
    <h1>Doctor Utilization</h1>
    <p>Appointment workload breakdown per doctor</p>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mb-4"><i class="bi bi-exclamation-circle me-2"></i>@ViewBag.Error</div>
}


<div class="card mb-4">
    <div class="card-header"><i class="bi bi-funnel me-2"></i>Filter by Date Range</div>
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">From</label>
                <input type="date" name="from" class="form-control" value="@Model?.From" />
            </div>
            <div class="col-md-4">
                <label class="form-label">To</label>
                <input type="date" name="to" class="form-control" value="@Model?.To" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-1"></i> Apply Filter
                </button>
            </div>
        </form>
    </div>
</div>


<div class="card">
    <div class="card-header"><i class="bi bi-person-badge me-2"></i>Doctor Workload</div>
    <div class="card-body p-0">
        @if (Model?.Doctors == null || !Model.Doctors.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-person-x" style="font-size:2.5rem;color:var(--text-light);"></i>
                <p class="mt-3" style="color:var(--text-mid);">No data for the selected period.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Doctor</th>
                            <th>Total</th>
                            <th>Completed</th>
                            <th>Cancelled</th>
                            <th>Missed</th>
                            <th>Completion Rate</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Doctors)
                        {
                            var rate = d.TotalAppointments > 0
                            ? Math.Round((double)d.CompletedAppointments / d.TotalAppointments * 100, 1)
                            : 0;
                            <tr>
                                <td style="font-weight:600;">Dr. @d.DoctorName</td>
                                <td><span class="badge bg-primary">@d.TotalAppointments</span></td>
                                <td><span class="badge bg-success">@d.CompletedAppointments</span></td>
                                <td><span class="badge bg-danger">@d.CancelledAppointments</span></td>
                                <td><span class="badge bg-warning text-dark">@d.MissedAppointments</span></td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress" style="height:6px;width:80px;background:var(--border);">
                                            <div class="progress-bar" style="width:@rate%;background:var(--primary);border-radius:99px;"></div>
                                        </div>
                                        <span style="font-size:12px;color:var(--text-mid);">@rate%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
