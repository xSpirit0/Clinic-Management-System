@model ClinicReporting.Models.SpecializationReport
@{
    ViewData["Title"] = "Appointments by Specialization";
}

<div class="page-header">
    <h1>Appointments by Specialization</h1>
    <p>Distribution of appointments across medical specializations</p>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mb-4"><i class="bi bi-exclamation-circle me-2"></i>@ViewBag.Error</div>
}

<!-- Filter -->
<div class="card mb-4">
    <div class="card-header"><i class="bi bi-funnel me-2"></i>Filter by Date Range</div>
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">From</label>
                <input type="date" name="from" class="form-control" value="@Model?.From" />
            </div>
            <div class="col-md-4">
                <label class="form-label">To</label>
                <input type="date" name="to" class="form-control" value="@Model?.To" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-1"></i> Apply Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div class="row g-4">
    <!-- Chart -->
    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-pie-chart me-2"></i>Distribution</div>
            <div class="card-body d-flex align-items-center justify-content-center">
                @if (Model?.Specializations == null || !Model.Specializations.Any())
                {
                    <div class="text-center py-4">
                        <i class="bi bi-heart-pulse" style="font-size:2.5rem;color:var(--text-light);"></i>
                        <p class="mt-3" style="color:var(--text-mid);">No data available.</p>
                    </div>
                }
                else
                {
                    <canvas id="specChart"></canvas>
                }
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="col-md-7">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-list-ul me-2"></i>Breakdown</div>
            <div class="card-body p-0">
                @if (Model?.Specializations == null || !Model.Specializations.Any())
                {
                    <div class="text-center py-5">
                        <p style="color:var(--text-mid);">No data for the selected period.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Specialization</th>
                                    <th>Appointments</th>
                                    <th>Share</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var total = Model.Specializations.Sum(s => s.AppointmentCount);
                                }
                                @foreach (var s in Model.Specializations)
                                {
                                    var pct = total > 0 ? Math.Round((double)s.AppointmentCount / total * 100, 1) : 0;
                                    <tr>
                                        <td style="font-weight:500;">@s.Specialization</td>
                                        <td><span class="badge bg-primary">@s.AppointmentCount</span></td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress" style="height:6px;width:80px;background:var(--border);">
                                                    <div class="progress-bar" style="width:@pct%;background:var(--primary);border-radius:99px;"></div>
                                                </div>
                                                <span style="font-size:12px;color:var(--text-mid);">@pct%</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const labels = [@Html.Raw(string.Join(",", Model?.Specializations.Select(x => $"\"{x.Specialization}\"") ?? new List<string>()))];
        const data   = [@Html.Raw(string.Join(",", Model?.Specializations.Select(x => x.AppointmentCount) ?? new List<int>()))];
        const colors = ['#1a56f0','#16a34a','#d97706','#e53e3e','#8b5cf6','#00c2b3','#fd7e14'];
        if (document.getElementById('specChart')) {
            new Chart(document.getElementById('specChart'), {
                type: 'pie',
                data: {
                    labels,
                    datasets: [{
                        data,
                        backgroundColor: colors.slice(0, labels.length),
                        borderWidth: 0,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        }
    </script>
}
