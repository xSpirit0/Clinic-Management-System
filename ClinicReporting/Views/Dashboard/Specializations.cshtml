@model ClinicReporting.Models.SpecializationReport
@{
    ViewData["Title"] = "Appointments by Specialization";
}

<div class="card p-4 mb-4">
    <h5 class="mb-3">Filter by Date Range</h5>
    <form method="get" class="row g-3">
        <div class="col-md-4">
            <label class="form-label">From</label>
            <input type="date" name="from" class="form-control" value="@Model?.From" />
        </div>
        <div class="col-md-4">
            <label class="form-label">To</label>
            <input type="date" name="to" class="form-control" value="@Model?.To" />
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Apply Filter</button>
        </div>
    </form>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card p-4">
            <h5 class="mb-3">Breakdown</h5>
            <canvas id="specChart"></canvas>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-4">
            <h5 class="mb-3">Details</h5>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Specialization</th>
                            <th>Appointments</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model?.Specializations ?? new())
                        {
                            <tr>
                                <td>@s.Specialization</td>
                                <td><span class="badge bg-primary">@s.AppointmentCount</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const labels = [@Html.Raw(string.Join(",", Model?.Specializations.Select(x => $"\"{x.Specialization}\"") ?? new List<string>()))];
    const data = [@Html.Raw(string.Join(",", Model?.Specializations.Select(x => x.AppointmentCount) ?? new List<int>()))];
    new Chart(document.getElementById('specChart'), {
        type: 'pie',
        data: {
            labels,
            datasets: [{
                data,
                backgroundColor: ['#0d6efd','#198754','#ffc107','#dc3545','#6f42c1','#0dcaf0','#fd7e14']
            }]
        }
    });
</script>
}