@model ClinicReporting.Models.AppointmentStatsReport
@{
    ViewData["Title"] = "Appointment Statistics";
}

<div class="page-header">
    <h1>Appointment Statistics</h1>
    <p>Breakdown of appointments by status for a given period</p>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mb-4"><i class="bi bi-exclamation-circle me-2"></i>@ViewBag.Error</div>
}


<div class="card mb-4">
    <div class="card-header"><i class="bi bi-funnel me-2"></i>Filter by Date Range</div>
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">From</label>
                <input type="date" name="from" class="form-control" value="@Model?.From" />
            </div>
            <div class="col-md-4">
                <label class="form-label">To</label>
                <input type="date" name="to" class="form-control" value="@Model?.To" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-1"></i> Apply Filter
                </button>
            </div>
        </form>
    </div>
</div>


<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card blue">
            <div class="stat-num text-primary">@Model?.TotalAppointments</div>
            <div class="stat-lbl">Total Appointments</div>
            @if (Model?.From != null || Model?.To != null)
            {
                <div style="font-size:12px;color:var(--text-light);margin-top:4px;">Filtered period</div>
            }
        </div>
    </div>
</div>


<div class="card">
    <div class="card-header"><i class="bi bi-bar-chart me-2"></i>Appointments by Status</div>
    <div class="card-body">
        @if (Model?.ByStatus == null || !Model.ByStatus.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x" style="font-size:2.5rem;color:var(--text-light);"></i>
                <p class="mt-3" style="color:var(--text-mid);">No data for the selected period.</p>
            </div>
        }
        else
        {
            <canvas id="statsChart" height="100"></canvas>
        }
    </div>
</div>

@section Scripts {
    <script>
        const labels = [@Html.Raw(string.Join(",", Model?.ByStatus.Select(x => $"\"{x.Status}\"") ?? new List<string>()))];
        const data   = [@Html.Raw(string.Join(",", Model?.ByStatus.Select(x => x.Count) ?? new List<int>()))];
        const colors = ['#1a56f0','#16a34a','#d97706','#e53e3e','#8b5cf6','#00c2b3','#6c757d'];
        if (document.getElementById('statsChart')) {
            new Chart(document.getElementById('statsChart'), {
                type: 'bar',
                data: {
                    labels,
                    datasets: [{
                        label: 'Appointments',
                        data,
                        backgroundColor: colors.slice(0, labels.length),
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { stepSize: 1 } }
                    }
                }
            });
        }
    </script>
}
