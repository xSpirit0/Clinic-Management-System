@model ClinicReporting.Models.SummaryReport
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <h1>Clinic Overview</h1>
    <p>@DateTime.Today.ToString("dddd, dd MMMM yyyy") — Summary of current clinic activity</p>
</div>


<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="stat-card blue">
            <div class="stat-num text-primary">@Model?.TotalPatients</div>
            <div class="stat-lbl">Total Patients</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card green">
            <div class="stat-num" style="color:var(--success)">@Model?.ActiveDoctors <span style="font-size:1rem;font-weight:500;color:var(--text-mid);">/ @Model?.TotalDoctors</span></div>
            <div class="stat-lbl">Active Doctors</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card teal">
            <div class="stat-num" style="color:var(--accent)">@Model?.TodayAppointments</div>
            <div class="stat-lbl">Today's Appointments</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card amber">
            <div class="stat-num" style="color:var(--warning)">@Model?.UpcomingAppointments</div>
            <div class="stat-lbl">Upcoming Appointments</div>
        </div>
    </div>
</div>


<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card red">
            <div class="stat-num" style="color:var(--danger)">@Model?.CancelledAppointments</div>
            <div class="stat-lbl">Cancelled Appointments</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="border:1px solid var(--border);">
            <div class="stat-num" style="color:#8b5cf6;">@Model?.MissedAppointments</div>
            <div class="stat-lbl">Missed Appointments</div>
            <div style="position:absolute;top:0;left:0;width:4px;height:100%;background:#8b5cf6;border-radius:4px 0 0 4px;"></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="border:1px solid var(--border);">
            <div class="stat-num" style="color:var(--text-dark);">@Model?.TotalAppointments</div>
            <div class="stat-lbl">Total Appointments</div>
            <div style="position:absolute;top:0;left:0;width:4px;height:100%;background:var(--text-light);border-radius:4px 0 0 4px;"></div>
        </div>
    </div>
</div>


<div class="card">
    <div class="card-header">
        <i class="bi bi-grid me-2"></i>Reports
    </div>
    <div class="card-body">
        <div class="row g-3">
            @foreach (var item in new[] {
                        new { Icon = "bi-calendar-check", Label = "Appointment Stats",   Action = "AppointmentStats", Color = "var(--primary)" },
                        new { Icon = "bi-x-circle",        Label = "Cancellation Rate",  Action = "CancellationRate", Color = "var(--danger)"  },
                        new { Icon = "bi-calendar-x",      Label = "Missed Appointments",Action = "MissedAppointments", Color = "#8b5cf6"      },
                        new { Icon = "bi-person-badge",    Label = "Doctor Utilization", Action = "DoctorUtilization",Color = "var(--success)" },
                        new { Icon = "bi-heart-pulse",     Label = "Specializations",    Action = "Specializations",  Color = "var(--accent)"  },
                        })
            {
                <div class="col-md-4 col-lg-2-4" style="flex:0 0 20%;max-width:20%;">
                    <a asp-action="@item.Action" style="text-decoration:none;">
                        <div class="card text-center h-100" style="padding:1.25rem .5rem;transition:all .15s;"
                             onmouseover="this.style.boxShadow='var(--shadow)';this.style.transform='translateY(-2px)'"
                             onmouseout="this.style.boxShadow='';this.style.transform=''">
                            <div style="font-size:2rem;color:@item.Color;margin-bottom:8px;">
                                <i class="bi @item.Icon"></i>
                            </div>
                            <div style="font-family:var(--font-display);font-weight:600;font-size:13px;color:var(--text-dark);">
                                @item.Label
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</div>
