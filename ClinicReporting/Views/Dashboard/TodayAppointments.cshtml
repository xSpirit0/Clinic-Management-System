@model ClinicReporting.Models.TodayAppointmentsReport
@{
    ViewData["Title"] = "Today's Appointments";
}

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card p-4 text-center">
            <div class="text-muted small">Today's Date</div>
            <div class="fs-4 fw-bold text-primary">@Model?.Date</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 text-center">
            <div class="text-muted small">Total Appointments</div>
            <div class="fs-1 fw-bold text-primary">@Model?.TotalAppointments</div>
        </div>
    </div>
</div>

<div class="card p-4">
    <h5 class="mb-3">Appointments Today</h5>
    @if (Model?.Appointments == null || !Model.Appointments.Any())
    {
        <div class="text-muted text-center py-4">No appointments today.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Time</th>
                        <th>Doctor</th>
                        <th>Specialization</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Appointments)
                    {
                        <tr>
                            <td>#@a.AppointmentId</td>
                            <td>@a.SlotStartTime - @a.SlotEndTime</td>
                            <td>@a.DoctorName</td>
                            <td>@a.Specialization</td>
                            <td>
                                <span class="badge bg-@(a.Status == "Completed" ? "success" : a.Status == "Cancelled" ? "danger" : a.Status == "Missed" ? "warning" : "primary")">
                                    @a.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>