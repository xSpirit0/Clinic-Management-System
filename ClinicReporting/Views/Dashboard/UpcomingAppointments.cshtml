@model ClinicReporting.Models.UpcomingAppointmentsReport
@{
    ViewData["Title"] = "Upcoming Appointments";
}
<div class="card p-4 mb-4">
    <h5 class="mb-3">Filter by Days Ahead</h5>
    <form method="get" class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Show next how many days?</label>
            <select name="days" class="form-select">
    @{
        var selectedDays = Context.Request.Query["days"].ToString();
        if (string.IsNullOrEmpty(selectedDays)) selectedDays = "7";
    }
             <option value="7" selected="@(selectedDays == "7" ? "selected" : null)">7 days</option>
             <option value="14" selected="@(selectedDays == "14" ? "selected" : null)">14 days</option>
             <option value="30" selected="@(selectedDays == "30" ? "selected" : null)">30 days</option>
             <option value="60" selected="@(selectedDays == "60" ? "selected" : null)">60 days</option>
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Apply</button>
        </div>
    </form>
</div>
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card p-4 text-center">
            <div class="text-muted small">From</div>
            <div class="fs-5 fw-bold text-primary">@Model?.From</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 text-center">
            <div class="text-muted small">To</div>
            <div class="fs-5 fw-bold text-primary">@Model?.To</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 text-center">
            <div class="text-muted small">Total Appointments</div>
            <div class="fs-1 fw-bold text-primary">@Model?.TotalAppointments</div>
        </div>
    </div>
</div>
<div class="card p-4">
    <h5 class="mb-3">Upcoming Appointments</h5>
    @if (Model?.Appointments == null || !Model.Appointments.Any())
    {
        <div class="text-muted text-center py-4">No upcoming appointments.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Doctor</th>
                        <th>Specialization</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Appointments)
                    {
                        <tr>
                            <td>#@a.AppointmentId</td>
                            <td>@a.ScheduledDate</td>
                            <td>@a.SlotStartTime - @a.SlotEndTime</td>
                            <td>@a.DoctorName</td>
                            <td>@a.Specialization</td>
                            <td>
                                <span class="badge bg-@(a.Status == "Completed" ? "success" : a.Status == "Cancelled" ? "danger" : a.Status == "Missed" ? "warning" : "primary")">
                                    @a.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>