@model ClinicReporting.Models.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Login - Clinic Reporting</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body style="background: linear-gradient(135deg, #0d6efd, #0a58ca); min-height:100vh; display:flex; align-items:center; justify-content:center;">
    <div class="card p-4" style="width:380px; border-radius:16px;">
        <div class="text-center mb-4">
            <i class="bi bi-hospital" style="font-size:2.5rem; color:#0d6efd;"></i>
            <h4 class="mt-2">Clinic Reporting</h4>
            <p class="text-muted small">Clinic Manager Access Only</p>
        </div>
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }
        <form asp-action="Login" method="post">
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input asp-for="Email" class="form-control" placeholder="Enter your email" />
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Login</button>
        </form>
    </div>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
</body>
</html>