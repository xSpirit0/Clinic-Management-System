<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Spirit Clinic Reports</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --primary: #1a56f0;
            --primary-dark: #1340c4;
            --primary-light: #e8eeff;
            --accent: #00c2b3;
            --text-dark: #0d1b3e;
            --text-mid: #4a5578;
            --text-light: #8a93b0;
            --surface: #f7f8fc;
            --border: #e4e8f5;
            --white: #ffffff;
            --danger: #e53e3e;
            --success: #16a34a;
            --warning: #d97706;
            --font-display: 'Sora', sans-serif;
            --font-body: 'DM Sans', sans-serif;
            --radius: 12px;
            --radius-sm: 8px;
            --shadow-sm: 0 1px 4px rgba(26,86,240,0.06);
            --shadow: 0 4px 20px rgba(26,86,240,0.10);
            --shadow-lg: 0 12px 40px rgba(26,86,240,0.14);
            --sidebar-width: 250px;
        }

        * { box-sizing: border-box; }

        body {
            font-family: var(--font-body);
            font-size: 15px;
            color: var(--text-dark);
            background: var(--surface);
            min-height: 100vh;
        }

        h1, h2, h3, h4, h5, h6 { font-family: var(--font-display); }

        .report-sidebar {
            width: var(--sidebar-width);
            min-height: 100vh;
            background: var(--white);
            border-right: 1px solid var(--border);
            position: fixed;
            top: 0;
            left: 0;
            display: flex;
            flex-direction: column;
            box-shadow: var(--shadow-sm);
            z-index: 100;
        }

        .sidebar-brand {
            padding: 20px 20px 16px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .sidebar-brand .brand-icon {
            width: 34px;
            height: 34px;
            background: var(--primary);
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 17px;
            flex-shrink: 0;
        }

        .sidebar-brand .brand-text {
            font-family: var(--font-display);
            font-size: 15px;
            font-weight: 700;
            color: var(--text-dark);
            line-height: 1.2;
        }

        .sidebar-brand .brand-text span { color: var(--primary); }

        .sidebar-brand .brand-sub {
            font-size: 11px;
            color: var(--text-light);
            font-weight: 400;
            font-family: var(--font-body);
        }

        .sidebar-nav {
            flex: 1;
            padding: 12px 10px;
            overflow-y: auto;
        }

        .sidebar-section {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--text-light);
            padding: 10px 10px 6px;
            font-family: var(--font-display);
        }

        .sidebar-nav a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 12px;
            border-radius: var(--radius-sm);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            color: var(--text-mid);
            transition: all 0.15s;
            margin-bottom: 2px;
        }

        .sidebar-nav a i {
            font-size: 16px;
            width: 20px;
            text-align: center;
            flex-shrink: 0;
        }

        .sidebar-nav a:hover {
            background: var(--primary-light);
            color: var(--primary);
        }

        .sidebar-nav a.active {
            background: var(--primary-light);
            color: var(--primary);
            font-weight: 600;
        }

        .sidebar-footer {
            padding: 12px 10px;
            border-top: 1px solid var(--border);
        }

        .sidebar-footer a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 12px;
            border-radius: var(--radius-sm);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            color: var(--text-mid);
            transition: all 0.15s;
        }

        .sidebar-footer a:hover {
            background: #fef2f2;
            color: var(--danger);
        }

        .report-main {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .report-topbar {
            background: var(--white);
            border-bottom: 1px solid var(--border);
            padding: 0 2rem;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 50;
            box-shadow: var(--shadow-sm);
        }

        .report-topbar .page-title {
            font-family: var(--font-display);
            font-size: 17px;
            font-weight: 600;
            color: var(--text-dark);
            margin: 0;
        }

        .report-topbar .user-info {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 5px 12px 5px 5px;
            border: 1px solid var(--border);
            border-radius: 99px;
            font-size: 13px;
            font-weight: 500;
            color: var(--text-dark);
            background: var(--white);
        }

        .report-topbar .user-avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--primary);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 700;
        }

        .role-badge {
            font-size: 11px;
            font-weight: 600;
            padding: 3px 8px;
            border-radius: 99px;
            background: #f3e5f5;
            color: #6a1b9a;
            font-family: var(--font-display);
        }

        .report-body { flex: 1; padding: 2rem; }

        .card {
            border: 1px solid var(--border) !important;
            border-radius: var(--radius) !important;
            box-shadow: var(--shadow-sm) !important;
            background: var(--white) !important;
        }

        .card-header {
            background: var(--white) !important;
            border-bottom: 1px solid var(--border) !important;
            font-family: var(--font-display);
            font-weight: 600;
            padding: 1rem 1.25rem !important;
            border-radius: var(--radius) var(--radius) 0 0 !important;
        }

        .stat-card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 1.25rem 1.5rem;
            position: relative;
            overflow: hidden;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
        }

        .stat-card.blue::before { background: var(--primary); }
        .stat-card.green::before { background: var(--success); }
        .stat-card.amber::before { background: var(--warning); }
        .stat-card.teal::before { background: var(--accent); }
        .stat-card.red::before { background: var(--danger); }

        .stat-card .stat-num {
            font-family: var(--font-display);
            font-size: 2rem;
            font-weight: 700;
            line-height: 1;
            margin-bottom: 4px;
        }

        .stat-card .stat-lbl {
            font-size: 13px;
            color: var(--text-mid);
            font-weight: 500;
        }

        .table { font-size: 14px; }

        .table thead th {
            font-family: var(--font-display);
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: var(--text-mid);
            border-bottom: 2px solid var(--border) !important;
            padding: 12px 16px;
        }

        .table td {
            padding: 12px 16px;
            vertical-align: middle;
            border-color: var(--border) !important;
            color: var(--text-dark);
        }

        .table-hover tbody tr:hover { background: var(--primary-light) !important; }

        .badge {
            font-family: var(--font-display);
            font-size: 11px;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 99px;
        }

        .form-control, .form-select {
            border: 1.5px solid var(--border);
            border-radius: var(--radius-sm) !important;
            font-size: 14px;
            color: var(--text-dark);
            padding: 10px 14px;
            transition: all 0.15s;
            background: var(--white);
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary) !important;
            box-shadow: 0 0 0 3px rgba(26,86,240,0.12) !important;
        }

        .form-label {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 6px;
            font-family: var(--font-display);
        }

        .btn-primary {
            background: var(--primary) !important;
            border-color: var(--primary) !important;
            font-family: var(--font-display);
            font-weight: 600;
            border-radius: var(--radius-sm) !important;
        }

        .btn-primary:hover {
            background: var(--primary-dark) !important;
            border-color: var(--primary-dark) !important;
        }

        .btn-outline-primary {
            color: var(--primary) !important;
            border-color: var(--primary) !important;
            font-family: var(--font-display);
            font-weight: 500;
            border-radius: var(--radius-sm) !important;
        }

        .btn-outline-primary:hover {
            background: var(--primary) !important;
            color: white !important;
        }

        .btn-outline-secondary {
            border-radius: var(--radius-sm) !important;
            font-family: var(--font-display);
        }

        .alert {
            border: none !important;
            border-radius: var(--radius) !important;
            font-size: 14px;
        }

        .alert-danger { background: #fef2f2 !important; color: #991b1b !important; }
        .alert-success { background: #ecfdf5 !important; color: #065f46 !important; }
        .alert-warning { background: #fffbeb !important; color: #92400e !important; }
        .alert-info { background: #eff6ff !important; color: #1e40af !important; }

        .page-header { margin-bottom: 1.75rem; }

        .page-header h1 {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 4px;
            letter-spacing: -0.02em;
        }

        .page-header p {
            color: var(--text-mid);
            font-size: 14px;
            margin: 0;
        }

        .report-footer {
            background: var(--white);
            border-top: 1px solid var(--border);
            padding: 1rem 2rem;
            font-size: 13px;
            color: var(--text-light);
        }
    </style>
</head>
<body>
    @if (Context.Session.GetString("JwtToken") != null)
    {
        <div class="report-sidebar">
            <a class="sidebar-brand" asp-controller="Dashboard" asp-action="Index">
                <div class="brand-icon"><i class="bi bi-heart-pulse-fill"></i></div>
                <div>
                    <div class="brand-text">Spirit <span>Clinic</span></div>
                    <div class="brand-sub">Reporting Portal</div>
                </div>
            </a>

            <nav class="sidebar-nav">
                <div class="sidebar-section">Overview</div>
                <a asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>

                <div class="sidebar-section">Reports</div>
                <a asp-controller="Dashboard" asp-action="AppointmentStats">
                    <i class="bi bi-calendar-check"></i> Appointment Stats
                </a>
                <a asp-controller="Dashboard" asp-action="CancellationRate">
                    <i class="bi bi-x-circle"></i> Cancellation Rate
                </a>
                <a asp-controller="Dashboard" asp-action="MissedAppointments">
                    <i class="bi bi-calendar-x"></i> Missed Appointments
                </a>
                <a asp-controller="Dashboard" asp-action="DoctorUtilization">
                    <i class="bi bi-person-badge"></i> Doctor Utilization
                </a>
                <a asp-controller="Dashboard" asp-action="Specializations">
                    <i class="bi bi-heart-pulse"></i> Specializations
                </a>
                <a asp-controller="Dashboard" asp-action="TodayAppointments">
                    <i class="bi bi-calendar-day"></i> Today's Appointments
                </a>
                <a asp-controller="Dashboard" asp-action="UpcomingAppointments">
                    <i class="bi bi-calendar-week"></i> Upcoming Appointments
                </a>
            </nav>

            <div class="sidebar-footer">
                <a asp-controller="Auth" asp-action="Logout">
                    <i class="bi bi-box-arrow-left"></i> Sign Out
                </a>
            </div>
        </div>

        <div class="report-main">
            <div class="report-topbar">
                <h1 class="page-title">@ViewData["Title"]</h1>
                <div class="user-info">
                    <div class="user-avatar">
                        @(ViewBag.FullName is string fn && fn.Length > 0 ? fn[0].ToString().ToUpper() : "M")
                    </div>
                    <span>@ViewBag.FullName</span>
                    <span class="role-badge">Manager</span>
                </div>
            </div>

            <div class="report-body">
                @RenderBody()
            </div>

            <footer class="report-footer">
                &copy; 2026 Spirit Clinic — Reporting Portal
            </footer>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>