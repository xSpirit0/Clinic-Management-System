@model ClinicAPI.Models.PatientProfile
@{
    ViewData["Title"] = "Patient Profile";
    var appointments = ViewBag.Appointments as List<ClinicAPI.Models.Appointment>
                       ?? new List<ClinicAPI.Models.Appointment>();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}


<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1>@(Model.AspNetUser?.FirstName ?? "—") @(Model.AspNetUser?.LastName ?? "")</h1>
        <p>Patient Profile — Ref: @Model.PatientReferenceNumber</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="SearchPatient" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
        <a asp-action="BookAppointment" asp-route-patientId="@Model.PatientId"
           class="btn btn-primary">
            <i class="bi bi-calendar-plus me-1"></i> Book Appointment
        </a>
    </div>
</div>

<div class="row g-4">
    
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-body text-center" style="padding:2rem 1.5rem;">
                <div style="width:72px;height:72px;background:var(--primary-light);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:700;color:var(--primary);margin:0 auto 1rem;">
                    @(Model.AspNetUser?.FirstName?.Length > 0 ? Model.AspNetUser.FirstName[0].ToString().ToUpper() : "P")
                </div>
                <h5 style="font-weight:700;margin-bottom:2px;">
                    @(Model.AspNetUser?.FirstName) @(Model.AspNetUser?.LastName)
                </h5>
                <p style="font-size:13px;color:var(--text-mid);margin-bottom:1rem;">@(Model.AspNetUser?.Email)</p>
                <span class="badge bg-success">Active Patient</span>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><i class="bi bi-person-vcard me-2"></i>Details</div>
            <div class="card-body">
                @foreach (var (label, value) in new (string, string)[] {
                    ("CPR Number",    Model.Cprnumber),
                    ("Reference",     Model.PatientReferenceNumber),
                    ("Date of Birth", Model.DateOfBirth.ToString("dd MMM yyyy")),
                    ("Gender",        Model.Gender ?? "—"),
                    ("Blood Type",    Model.BloodType ?? "—"),
                    ("Emergency",     Model.EmergencyContactName ?? "—"),
                    ("Emergency Ph.", Model.EmergencyContactPhone ?? "—"),
                })
                {
                    <div class="d-flex justify-content-between py-2"
                         style="border-bottom:1px solid var(--border);font-size:13px;">
                        <span style="color:var(--text-mid);">@label</span>
                        <span style="font-weight:500;text-align:right;">@value</span>
                    </div>
                }
            </div>
        </div>
    </div>

  
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-calendar2 me-2"></i>Recent Appointments</span>
                <span style="font-size:12px;color:var(--text-light);">Last 10</span>
            </div>
            <div class="card-body p-0">
                @if (!appointments.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-calendar-x" style="font-size:2.5rem;color:var(--text-light);"></i>
                        <p class="mt-3" style="color:var(--text-mid);">No appointments found for this patient</p>
                        <a asp-action="BookAppointment" asp-route-patientId="@Model.PatientId"
                           class="btn btn-sm btn-primary">
                            Book First Appointment
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Doctor</th>
                                    <th>Specialization</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appt in appointments)
                                {
                                    var s = appt.AppointmentStatus?.AppointmentStatus1 ?? "";
                                    var bc = s switch
                                    {
                                        "Requested"  => "bg-secondary",
                                        "Confirmed"  => "bg-primary",
                                        "CheckedIn"  => "bg-info",
                                        "InProgress" => "bg-warning text-dark",
                                        "Completed"  => "bg-success",
                                        "Cancelled"  => "bg-danger",
                                        "Missed"     => "bg-dark",
                                        _            => "bg-secondary"
                                    };
                                    <tr>
                                        <td>
                                            <div style="font-weight:600;font-size:13px;">
                                                @appt.ScheduledDate.ToString("dd MMM yyyy")
                                            </div>
                                            <div style="font-size:12px;color:var(--text-light);">
                                                @appt.SlotStartTime.ToString("HH\\:mm")
                                            </div>
                                        </td>
                                        <td style="font-size:13px;">
                                            @if (appt.Doctor?.AspNetUser != null)
                                            {
                                                <span>Dr. @appt.Doctor.AspNetUser.FirstName @appt.Doctor.AspNetUser.LastName</span>
                                            }
                                        </td>
                                        <td style="font-size:13px;">@appt.Specialization?.Name</td>
                                        <td><span class="badge @bc">@s</span></td>
                                        <td>
                                            <a asp-action="AppointmentDetails" asp-route-id="@appt.AppointmentId"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
