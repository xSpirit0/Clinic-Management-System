@{
    ViewData["Title"] = "Reception Dashboard";
    var todayAppointments = ViewBag.TodayAppointments as List<ClinicAPI.Models.Appointment>
                            ?? new List<ClinicAPI.Models.Appointment>();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}


<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1>Reception Dashboard</h1>
        <p>@DateTime.Today.ToString("dddd, dd MMMM yyyy") — Today's queue overview</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="SearchPatient" class="btn btn-outline-primary">
            <i class="bi bi-search me-1"></i> Find Patient
        </a>
        <a asp-action="BookAppointment" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Book Appointment
        </a>
        <a asp-action="WaitingRoomBoard" class="btn btn-outline-primary" target="_blank">
            <i class="bi bi-display me-1"></i> Waiting Room Board
        </a>
    </div>
</div>


<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card blue">
            <div class="stat-num text-primary">@ViewBag.TotalToday</div>
            <div class="stat-lbl">Total Today</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card amber">
            <div class="stat-num" style="color:var(--warning)">@ViewBag.PendingToday</div>
            <div class="stat-lbl">Pending / Waiting</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card teal">
            <div class="stat-num" style="color:var(--accent)">@ViewBag.CheckedIn</div>
            <div class="stat-lbl">Checked In / In Progress</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card green">
            <div class="stat-num" style="color:var(--success)">@ViewBag.CompletedToday</div>
            <div class="stat-lbl">Completed Today</div>
        </div>
    </div>
</div>


<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-list-check me-2"></i>Today's Appointment Queue</span>
        <a asp-action="AllAppointments" asp-route-filter="today" class="btn btn-sm btn-outline-secondary">
            View All <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
    <div class="card-body p-0">
        @if (!todayAppointments.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x" style="font-size:2.5rem;color:var(--text-light);"></i>
                <p class="mt-3 mb-1" style="color:var(--text-mid);font-weight:500;">No appointments scheduled for today</p>
                <p style="color:var(--text-light);font-size:13px;">Use the Book Appointment button to add one</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Specialization</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in todayAppointments)
                        {
                            var status = appt.AppointmentStatus?.AppointmentStatus1 ?? "";
                            var (badgeClass, icon) = status switch
                            {
                                "Requested"  => ("bg-secondary", "bi-clock"),
                                "Confirmed"  => ("bg-primary",   "bi-check-circle"),
                                "CheckedIn"  => ("bg-info",      "bi-door-open"),
                                "InProgress" => ("bg-warning text-dark", "bi-activity"),
                                "Completed"  => ("bg-success",   "bi-check-all"),
                                "Cancelled"  => ("bg-danger",    "bi-x-circle"),
                                "Missed"     => ("bg-dark",      "bi-dash-circle"),
                                _            => ("bg-secondary", "bi-question")
                            };
                            <tr>
                                <td>
                                    <span style="font-family:var(--font-display);font-weight:600;font-size:14px;">
                                        @appt.SlotStartTime.ToString("HH\\:mm")
                                    </span>
                                    <span style="color:var(--text-light);font-size:12px;"> – @appt.SlotEndTime.ToString("HH\\:mm")</span>
                                </td>
                                <td>
                                    @if (appt.Patient?.AspNetUser != null)
                                    {
                                        <span>@appt.Patient.AspNetUser.FirstName @appt.Patient.AspNetUser.LastName</span>
                                        <div style="font-size:12px;color:var(--text-light);">@appt.Patient.Cprnumber</div>
                                    }
                                    else { <span style="color:var(--text-light);">—</span> }
                                </td>
                                <td>
                                    @if (appt.Doctor?.AspNetUser != null)
                                    {
                                        <span>Dr. @appt.Doctor.AspNetUser.FirstName @appt.Doctor.AspNetUser.LastName</span>
                                    }
                                    else { <span style="color:var(--text-light);">—</span> }
                                </td>
                                <td style="font-size:13px;">@appt.Specialization?.Name</td>
                                <td><span class="badge @badgeClass"><i class="bi @icon me-1"></i>@status</span></td>
                                <td>
                                    <a asp-action="AppointmentDetails" asp-route-id="@appt.AppointmentId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
