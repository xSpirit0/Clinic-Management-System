@model List<ClinicAPI.Models.Appointment>
@{
    ViewData["Title"] = "All Appointments";
    var currentFilter = ViewBag.CurrentFilter as string ?? "today";
    var currentStatus = ViewBag.CurrentStatus as string ?? "all";
    var search        = ViewBag.Search as string ?? "";
    var allStatuses   = ViewBag.AllStatuses as List<string> ?? new List<string>();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1>All Appointments</h1>
        <p>@Model.Count appointment(s) found</p>
    </div>
    <a asp-action="BookAppointment" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Book Appointment
    </a>
</div>


<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="AllAppointments" class="row g-3 align-items-end">
            
            <div class="col-12">
                <label class="form-label">Date Range</label>
                <div class="d-flex gap-2 flex-wrap">
                    @foreach (var (label, val) in new[] { ("Today","today"),("Upcoming","upcoming"),("Past","past"),("All","all") })
                    {
                        <a asp-action="AllAppointments"
                           asp-route-filter="@val"
                           asp-route-status="@currentStatus"
                           asp-route-search="@search"
                           class="btn btn-sm @(currentFilter == val ? "btn-primary" : "btn-outline-secondary")">
                            @label
                        </a>
                    }
                </div>
            </div>
            
            <div class="col-md-4">
                <label class="form-label">Status</label>
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="all" selected="@(currentStatus == "all")">All Statuses</option>
                    @foreach (var s in allStatuses)
                    {
                        <option value="@s" selected="@(currentStatus == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label">Search Patient</label>
                <div class="input-group">
                    <span class="input-group-text" style="border-color:var(--border);">
                        <i class="bi bi-search" style="color:var(--text-light);"></i>
                    </span>
                    <input type="text" name="search" value="@search" class="form-control"
                           placeholder="Name or CPR number…">
                </div>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i> Filter
                </button>
            </div>
        </form>
    </div>
</div>


<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x" style="font-size:2.5rem;color:var(--text-light);"></i>
                <p class="mt-3 mb-1" style="color:var(--text-mid);font-weight:500;">No appointments found</p>
                <p style="color:var(--text-light);font-size:13px;">Try adjusting the filters above</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Date & Time</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Specialization</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model)
                        {
                            var status = appt.AppointmentStatus?.AppointmentStatus1 ?? "";
                            var badgeClass = status switch
                            {
                                "Requested"  => "bg-secondary",
                                "Confirmed"  => "bg-primary",
                                "CheckedIn"  => "bg-info",
                                "InProgress" => "bg-warning text-dark",
                                "Completed"  => "bg-success",
                                "Cancelled"  => "bg-danger",
                                "Missed"     => "bg-dark",
                                _            => "bg-secondary"
                            };
                            <tr>
                                <td style="color:var(--text-light);font-size:12px;">#@appt.AppointmentId</td>
                                <td>
                                    <div style="font-family:var(--font-display);font-weight:600;font-size:13px;">
                                        @appt.ScheduledDate.ToString("dd MMM yyyy")
                                    </div>
                                    <div style="font-size:12px;color:var(--text-light);">
                                        @appt.SlotStartTime.ToString("HH\\:mm") – @appt.SlotEndTime.ToString("HH\\:mm")
                                    </div>
                                </td>
                                <td>
                                    @if (appt.Patient?.AspNetUser != null)
                                    {
                                        <div style="font-weight:500;font-size:13px;">
                                            @appt.Patient.AspNetUser.FirstName @appt.Patient.AspNetUser.LastName
                                        </div>
                                        <div style="font-size:12px;color:var(--text-light);">@appt.Patient.Cprnumber</div>
                                    }
                                </td>
                                <td style="font-size:13px;">
                                    @if (appt.Doctor?.AspNetUser != null)
                                    {
                                        <span>Dr. @appt.Doctor.AspNetUser.FirstName @appt.Doctor.AspNetUser.LastName</span>
                                    }
                                </td>
                                <td style="font-size:13px;">@appt.Specialization?.Name</td>
                                <td><span class="badge @badgeClass">@status</span></td>
                                <td>
                                    <a asp-action="AppointmentDetails" asp-route-id="@appt.AppointmentId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
