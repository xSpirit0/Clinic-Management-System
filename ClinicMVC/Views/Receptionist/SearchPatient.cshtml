@model List<ClinicAPI.Models.PatientProfile>
@{
    ViewData["Title"] = "Search Patient";
    var query = ViewBag.Query as string ?? "";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1>Search Patient</h1>
        <p>Find a patient by name, CPR number, or reference number</p>
    </div>
    <a asp-action="BookAppointment" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Book Appointment
    </a>
</div>

<!-- Search Box -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="SearchPatient">
            <div class="row g-3 align-items-end">
                <div class="col-md-9">
                    <label class="form-label">Search</label>
                    <div class="input-group">
                        <span class="input-group-text" style="border-color:var(--border);">
                            <i class="bi bi-search" style="color:var(--text-light);"></i>
                        </span>
                        <input type="text" name="query" value="@query" class="form-control"
                               placeholder="Patient name, CPR number, or reference number…"
                               autofocus>
                    </div>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        Search
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>


@if (!string.IsNullOrEmpty(query))
{
    <div class="card">
        <div class="card-header">
            <i class="bi bi-person-lines-fill me-2"></i>
            @if (Model.Any())
            {
                <span>@Model.Count patient(s) found for "@query"</span>
            }
            else
            {
                <span>No patients found for "@query"</span>
            }
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-person-x" style="font-size:2.5rem;color:var(--text-light);"></i>
                    <p class="mt-3 mb-1" style="color:var(--text-mid);font-weight:500;">No patients matched your search</p>
                    <p style="color:var(--text-light);font-size:13px;">Try a different name or CPR number</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Patient</th>
                                <th>CPR Number</th>
                                <th>Reference</th>
                                <th>Date of Birth</th>
                                <th>Blood Type</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td>
                                        <div style="font-weight:600;font-size:14px;">
                                            @(p.AspNetUser?.FirstName ?? "—") @(p.AspNetUser?.LastName ?? "")
                                        </div>
                                        <div style="font-size:12px;color:var(--text-light);">
                                            @(p.AspNetUser?.Email ?? "—")
                                        </div>
                                    </td>
                                    <td style="font-family:var(--font-display);font-size:13px;">@p.Cprnumber</td>
                                    <td style="font-size:13px;color:var(--text-mid);">@p.PatientReferenceNumber</td>
                                    <td style="font-size:13px;">@p.DateOfBirth.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(p.BloodType))
                                        {
                                            <span class="badge bg-danger">@p.BloodType</span>
                                        }
                                        else { <span style="color:var(--text-light);">—</span> }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <a asp-action="PatientProfile" asp-route-id="@p.PatientId"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-person me-1"></i> Profile
                                            </a>
                                            <a asp-action="BookAppointment" asp-route-patientId="@p.PatientId"
                                               class="btn btn-sm btn-primary">
                                                <i class="bi bi-calendar-plus me-1"></i> Book
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="text-center py-5">
            <i class="bi bi-person-search" style="font-size:3rem;color:var(--primary);opacity:.3;"></i>
            <p class="mt-3" style="color:var(--text-mid);">Enter a name or CPR number above to search</p>
        </div>
    </div>
}
