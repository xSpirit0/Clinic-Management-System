@model ClinicAPI.Models.Appointment
@{
    ViewData["Title"] = "Appointment Details";
    var status = Model.AppointmentStatus?.AppointmentStatus1 ?? "";
    var badgeClass = status switch
    {
        "Requested"  => "bg-secondary",
        "Confirmed"  => "bg-primary",
        "CheckedIn"  => "bg-info",
        "InProgress" => "bg-warning text-dark",
        "Completed"  => "bg-success",
        "Cancelled"  => "bg-danger",
        "Missed"     => "bg-dark",
        _            => "bg-secondary"
    };
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}


<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1>Appointment #@Model.AppointmentId</h1>
        <p>
            @Model.ScheduledDate.ToString("dddd, dd MMMM yyyy") ·
            @Model.SlotStartTime.ToString("HH\\:mm") – @Model.SlotEndTime.ToString("HH\\:mm")
        </p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="badge @badgeClass" style="font-size:13px;padding:7px 14px;">@status</span>
        <a asp-action="AllAppointments" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row g-4">
   
    <div class="col-lg-8">
       
        <div class="card mb-4">
            <div class="card-header">
                <i class="bi bi-people me-2"></i>Parties Involved
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div style="background:var(--surface);border-radius:var(--radius-sm);padding:1rem;">
                            <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--text-light);margin-bottom:8px;">
                                Patient
                            </div>
                            @if (Model.Patient?.AspNetUser != null)
                            {
                                <div style="font-weight:600;font-size:15px;margin-bottom:2px;">
                                    @Model.Patient.AspNetUser.FirstName @Model.Patient.AspNetUser.LastName
                                </div>
                                <div style="font-size:13px;color:var(--text-mid);">CPR: @Model.Patient.Cprnumber</div>
                                <div style="font-size:13px;color:var(--text-mid);">Ref: @Model.Patient.PatientReferenceNumber</div>
                                <a asp-action="PatientProfile" asp-route-id="@Model.PatientId"
                                   class="btn btn-sm btn-outline-primary mt-2">
                                    <i class="bi bi-person me-1"></i> View Profile
                                </a>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div style="background:var(--surface);border-radius:var(--radius-sm);padding:1rem;">
                            <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--text-light);margin-bottom:8px;">
                                Doctor
                            </div>
                            @if (Model.Doctor?.AspNetUser != null)
                            {
                                <div style="font-weight:600;font-size:15px;margin-bottom:2px;">
                                    Dr. @Model.Doctor.AspNetUser.FirstName @Model.Doctor.AspNetUser.LastName
                                </div>
                                <div style="font-size:13px;color:var(--text-mid);">
                                    @Model.Specialization?.Name
                                </div>
                                <div style="font-size:13px;color:var(--text-mid);">
                                    License: @Model.Doctor.LicenseNumber
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        
        <div class="card mb-4">
            <div class="card-header"><i class="bi bi-info-circle me-2"></i>Appointment Info</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">Date</div>
                        <div style="font-weight:500;">@Model.ScheduledDate.ToString("dd MMMM yyyy")</div>
                    </div>
                    <div class="col-sm-6">
                        <div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">Time Slot</div>
                        <div style="font-weight:500;">@Model.SlotStartTime.ToString("HH\\:mm") – @Model.SlotEndTime.ToString("HH\\:mm")</div>
                    </div>
                    <div class="col-sm-6">
                        <div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">Specialization</div>
                        <div style="font-weight:500;">@Model.Specialization?.Name</div>
                    </div>
                    <div class="col-sm-6">
                        <div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">Booked At</div>
                        <div style="font-weight:500;">@Model.CreatedAt.ToString("dd MMM yyyy, HH\\:mm")</div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.ComplaintReason))
                    {
                        <div class="col-12">
                            <div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">Complaint / Reason</div>
                            <div style="font-weight:500;">@Model.ComplaintReason</div>
                        </div>
                    }
                </div>
            </div>
        </div>

       
        @if (Model.AppointmentStatusHistories?.Any() == true)
        {
            <div class="card mb-4">
                <div class="card-header"><i class="bi bi-clock-history me-2"></i>Status History</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th>Changed At</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in Model.AppointmentStatusHistories)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-secondary">
                                                @h.AppointmentStatus?.AppointmentStatus1
                                            </span>
                                        </td>
                                        <td style="font-size:13px;">@h.ChangedAt.ToString("dd MMM yyyy, HH\\:mm")</td>
                                        <td style="font-size:13px;color:var(--text-mid);">@(h.Notes ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>

    
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header"><i class="bi bi-lightning me-2"></i>Quick Actions</div>
            <div class="card-body d-flex flex-column gap-2">

                @if (status == "Requested")
                {
                    <form asp-action="UpdateStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.AppointmentId" />
                        <input type="hidden" name="newStatus" value="Confirmed" />
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-check-circle me-1"></i> Confirm Appointment
                        </button>
                    </form>
                }

                @if (status == "Confirmed")
                {
                    <form asp-action="UpdateStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.AppointmentId" />
                        <input type="hidden" name="newStatus" value="CheckedIn" />
                        <button type="submit" class="btn btn-info w-100 text-white">
                            <i class="bi bi-door-open me-1"></i> Check In Patient
                        </button>
                    </form>
                }

                @if (status != "Completed" && status != "Cancelled" && status != "Missed")
                {
                  
                    <button class="btn btn-outline-danger w-100" data-bs-toggle="modal" data-bs-target="#cancelModal">
                        <i class="bi bi-x-circle me-1"></i> Cancel Appointment
                    </button>
                    <button class="btn btn-outline-secondary w-100" data-bs-toggle="modal" data-bs-target="#missedModal">
                        <i class="bi bi-dash-circle me-1"></i> Mark as Missed
                    </button>
                }

                @if (status == "Completed" || status == "Cancelled" || status == "Missed")
                {
                    <div class="text-center py-2" style="color:var(--text-light);font-size:13px;">
                        <i class="bi bi-lock me-1"></i> No further actions available
                    </div>
                }
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cancel Appointment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="UpdateStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.AppointmentId" />
                <input type="hidden" name="newStatus" value="Cancelled" />
                <div class="modal-body">
                    <label class="form-label">Reason for cancellation (optional)</label>
                    <textarea name="notes" class="form-control" rows="3"
                              placeholder="e.g. Patient requested cancellation"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Back</button>
                    <button type="submit" class="btn btn-danger">Confirm Cancellation</button>
                </div>
            </form>
        </div>
    </div>
</div>


<div class="modal fade" id="missedModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Mark as Missed</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="UpdateStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.AppointmentId" />
                <input type="hidden" name="newStatus" value="Missed" />
                <div class="modal-body">
                    <p style="color:var(--text-mid);font-size:14px;">
                        Mark this appointment as missed? This means the patient did not show up.
                    </p>
                    <label class="form-label">Notes (optional)</label>
                    <textarea name="notes" class="form-control" rows="2"
                              placeholder="Any additional notes"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Back</button>
                    <button type="submit" class="btn btn-dark">Mark as Missed</button>
                </div>
            </form>
        </div>
    </div>
</div>
