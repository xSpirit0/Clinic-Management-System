@model IEnumerable<ClinicAPI.Models.Appointment>

@{
    ViewData["Title"] = "Today's Appointments";
    string currentStatus = ViewBag.CurrentStatus ?? "all";
    int currentDoctorId = ViewBag.CurrentDoctorId ?? 0;
    var allStatuses = ViewBag.AllStatuses as List<string> ?? new List<string>();
    var allDoctors = ((dynamic)ViewBag.AllDoctors) as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Today's Appointments</h1>
        <a asp-action="Dashboard" class="btn btn-link">← Dashboard</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <form method="get" asp-action="TodayAppointments" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small mb-1">Status</label>
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        <option value="all" selected="@(currentStatus == "all")">All Statuses</option>
                        @foreach (var s in allStatuses)
                        {
                            <option value="@s" selected="@(currentStatus == s)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1">Doctor</label>
                    <select name="doctorId" class="form-select" onchange="this.form.submit()">
                        <option value="0" selected="@(currentDoctorId == 0)">All Doctors</option>
                        @foreach (var d in allDoctors)
                        {
                            <option value="@d.DoctorId" selected="@(currentDoctorId == d.DoctorId)">@d.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 text-end">
                    <small class="text-muted">@Model.Count() appointment(s)</small>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card">
            <div class="card-body text-center p-5">
                <h5 class="text-muted">No appointments match these filters.</h5>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Time</th>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Specialization</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model)
                            {
                                var status = a.AppointmentStatus.AppointmentStatus1;
                                var badgeClass = status switch
                                {
                                    "Requested"  => "bg-warning text-dark",
                                    "Confirmed"  => "bg-info text-dark",
                                    "CheckedIn"  => "bg-primary",
                                    "InProgress" => "bg-primary",
                                    "Completed"  => "bg-success",
                                    "Cancelled"  => "bg-danger",
                                    "Missed"     => "bg-secondary",
                                    _ => "bg-light text-dark"
                                };
                                <tr>
                                    <td>
                                        <strong>@a.SlotStartTime.ToString("HH:mm")</strong>
                                        <small class="text-muted d-block">
                                            to @a.SlotEndTime.ToString("HH:mm")
                                        </small>
                                    </td>
                                    <td>
                                        @(a.Patient?.AspNetUser?.FirstName ?? "—") @(a.Patient?.AspNetUser?.LastName ?? "—")
                                        <small class="text-muted d-block">
                                            CPR: @(a.Patient?.Cprnumber ?? "—")
                                        </small>
                                    </td>
                                    <td>@(a.Doctor?.AspNetUser?.FirstName ?? "—") @(a.Doctor?.AspNetUser?.LastName ?? "—")</td>
                                    <td>@(a.Specialization?.Name ?? "—")</td>
                                    <td><span class="badge @badgeClass">@status</span></td>
                                    <td class="text-end">
                                        @if (status == "Confirmed")
                                        {
                                            <form asp-action="CheckIn" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@a.AppointmentId" />
                                                <button type="submit" class="btn btn-sm btn-primary">
                                                    Check In
                                                </button>
                                            </form>
                                        }
                                        <a asp-action="AppointmentDetails" asp-route-id="@a.AppointmentId"
                                           class="btn btn-sm btn-outline-secondary">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

</div>
