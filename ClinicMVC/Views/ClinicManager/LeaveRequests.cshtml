@model List<ClinicAPI.Models.DoctorLeave>
@{
    ViewData["Title"] = "Leave Requests";
    var filter       = ViewBag.Filter as string ?? "pending";
    var pendingCount = (int)(ViewBag.PendingCount ?? 0);
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1>Leave Requests</h1>
        <p>
            @if (pendingCount > 0)
            { <span class="badge bg-warning text-dark me-2">@pendingCount pending</span> }
            @Model.Count request(s) shown
        </p>
    </div>
</div>


<div class="d-flex gap-2 mb-4">
    @foreach (var (label, val, color) in new[] {
        ("Pending",  "pending",  "btn-warning"),
        ("Approved", "approved", "btn-success"),
        ("Rejected", "rejected", "btn-danger"),
    })
    {
        <a asp-action="LeaveRequests" asp-route-filter="@val"
           class="btn @(filter == val ? color : "btn-outline-secondary")">
            @label
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="text-center py-5">
            <i class="bi bi-calendar-check" style="font-size:2.5rem;color:var(--text-light);"></i>
            <p class="mt-3" style="color:var(--text-mid);">No @filter leave requests.</p>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var l in Model)
        {
            var days = l.EndDate.DayNumber - l.StartDate.DayNumber + 1;
            var lStatus = l.LeaveStatus?.LeaveStatus1 ?? "";
            var lbc = lStatus switch {
                "Approved" => "bg-success",
                "Rejected" => "bg-danger",
                _          => "bg-warning text-dark"
            };

            <div class="card">
                <div class="card-body">
                    <div class="row align-items-center g-3">
                       
                        <div class="col-md-3">
                            <div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">Doctor</div>
                            <div style="font-weight:600;font-size:14px;">
                                Dr. @(l.Doctor?.AspNetUser?.FirstName ?? "—") @(l.Doctor?.AspNetUser?.LastName ?? "")
                            </div>
                        </div>
                        
                        <div class="col-md-3">
                            <div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">Period</div>
                            <div style="font-weight:500;font-size:13px;">
                                @l.StartDate.ToString("dd MMM yyyy") – @l.EndDate.ToString("dd MMM yyyy")
                            </div>
                            <div style="font-size:12px;color:var(--text-light);">@days day(s)</div>
                        </div>
                        
                        <div class="col-md-3">
                            <div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">Reason</div>
                            <div style="font-size:13px;color:var(--text-mid);">@(l.Reason ?? "—")</div>
                            @if (!string.IsNullOrWhiteSpace(l.RejectionReason))
                            {
                                <div style="font-size:12px;color:var(--danger);margin-top:2px;">
                                    Rejection: @l.RejectionReason
                                </div>
                            }
                        </div>
                        
                        <div class="col-md-3">
                            <div class="d-flex flex-column gap-2 align-items-end">
                                <span class="badge @lbc" style="font-size:12px;padding:5px 12px;">@lStatus</span>

                                @if (lStatus == "Pending")
                                {
                                    <div class="d-flex gap-2 w-100 justify-content-end">
                                        <form asp-action="ApproveLeave" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="leaveId" value="@l.DoctorLeaveId" />
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="bi bi-check-lg me-1"></i> Approve
                                            </button>
                                        </form>
                                        <button class="btn btn-sm btn-outline-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#rejectModal-@l.DoctorLeaveId">
                                            <i class="bi bi-x-lg me-1"></i> Reject
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

           
            <div class="modal fade" id="rejectModal-@l.DoctorLeaveId" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Reject Leave Request</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <form asp-action="RejectLeave" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="leaveId" value="@l.DoctorLeaveId" />
                            <div class="modal-body">
                                <label class="form-label">Reason for rejection *</label>
                                <textarea name="rejectionReason" class="form-control" rows="3" required
                                          placeholder="Please provide a reason…"></textarea>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-danger">Confirm Rejection</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
