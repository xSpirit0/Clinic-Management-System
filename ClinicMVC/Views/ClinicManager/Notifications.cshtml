@model IEnumerable<ClinicAPI.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1>Notifications</h1>
        <p>System alerts and updates for your clinic</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3">@TempData["Success"]</div>
}

@if (!Model.Any())
{
    <div class="card">
        <div class="text-center py-5">
            <i class="bi bi-bell-slash" style="font-size:2.5rem;color:var(--text-light);"></i>
            <p class="mt-3 mb-1" style="color:var(--text-mid);font-weight:500;">No notifications</p>
            <p style="font-size:13px;color:var(--text-light);">You're all caught up!</p>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column gap-2">
        @foreach (var n in Model)
        {
            <div class="card @(n.IsRead ? "" : "border-primary")"
                 style="@(n.IsRead ? "" : "border-left: 3px solid var(--primary) !important;")">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="d-flex align-items-center gap-2">
                            @if (!n.IsRead)
                            {
                                <span class="badge bg-primary">NEW</span>
                            }
                            <span style="font-weight:600;font-size:14px;">@n.Title</span>
                            <span style="font-size:12px;color:var(--text-light);">
                                — @(n.NotificationType?.Type ?? "")
                            </span>
                        </div>
                        <span style="font-size:12px;color:var(--text-light);white-space:nowrap;">
                            @n.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                        </span>
                    </div>
                    <p style="font-size:13px;color:var(--text-mid);margin:6px 0 0;">@n.Message</p>
                    @if (n.AppointmentId.HasValue)
                    {
                        <div class="mt-2">
                            <a asp-controller="ClinicManager" asp-action="AppointmentDetails"
                               asp-route-id="@n.AppointmentId"
                               style="font-size:13px;color:var(--primary);font-weight:500;">
                                View related appointment <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
