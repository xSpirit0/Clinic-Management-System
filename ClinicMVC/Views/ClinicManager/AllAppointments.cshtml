@model List<ClinicAPI.Models.Appointment>
@{
    ViewData["Title"] = "All Appointments";
    var filter      = ViewBag.Filter as string ?? "today";
    var status      = ViewBag.Status as string ?? "all";
    var search      = ViewBag.Search as string ?? "";
    var allStatuses = ViewBag.AllStatuses as List<string> ?? new List<string>();
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1>All Appointments</h1>
        <p>@Model.Count appointment(s) found</p>
    </div>
</div>


<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="AllAppointments" class="row g-3 align-items-end">
            <div class="col-12">
                <label class="form-label">Date Range</label>
                <div class="d-flex gap-2 flex-wrap">
                    @foreach (var (label, val) in new[] { ("Today","today"),("Upcoming","upcoming"),("Past","past"),("All","all") })
                    {
                        <a asp-action="AllAppointments"
                           asp-route-filter="@val"
                           asp-route-status="@status"
                           asp-route-search="@search"
                           class="btn btn-sm @(filter == val ? "btn-primary" : "btn-outline-secondary")">
                            @label
                        </a>
                    }
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="all" selected="@(status == "all")">All Statuses</option>
                    @foreach (var s in allStatuses)
                    {
                        <option value="@s" selected="@(status == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label">Search</label>
                <div class="input-group">
                    <span class="input-group-text" style="border-color:var(--border);">
                        <i class="bi bi-search" style="color:var(--text-light);"></i>
                    </span>
                    <input type="text" name="search" value="@search" class="form-control"
                           placeholder="Patient or doctor name…">
                </div>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <input type="hidden" name="filter" value="@filter" />
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bi bi-funnel me-1"></i> Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x" style="font-size:2.5rem;color:var(--text-light);"></i>
                <p class="mt-3" style="color:var(--text-mid);">No appointments match these filters.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Date & Time</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Specialization</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            var s = a.AppointmentStatus?.AppointmentStatus1 ?? "";
                            var bc = s switch {
                                "Requested"  => "bg-secondary",
                                "Confirmed"  => "bg-primary",
                                "CheckedIn"  => "bg-info",
                                "InProgress" => "bg-warning text-dark",
                                "Completed"  => "bg-success",
                                "Cancelled"  => "bg-danger",
                                "Missed"     => "bg-dark",
                                _            => "bg-secondary"
                            };
                            <tr>
                                <td style="color:var(--text-light);font-size:12px;">#@a.AppointmentId</td>
                                <td>
                                    <div style="font-weight:600;font-size:13px;">@a.ScheduledDate.ToString("dd MMM yyyy")</div>
                                    <div style="font-size:12px;color:var(--text-light);">@a.SlotStartTime.ToString("HH\\:mm") – @a.SlotEndTime.ToString("HH\\:mm")</div>
                                </td>
                                <td style="font-size:13px;">
                                    @(a.Patient?.AspNetUser?.FirstName ?? "—") @(a.Patient?.AspNetUser?.LastName ?? "")
                                </td>
                                <td style="font-size:13px;">
                                    Dr. @(a.Doctor?.AspNetUser?.FirstName ?? "—") @(a.Doctor?.AspNetUser?.LastName ?? "")
                                </td>
                                <td style="font-size:13px;">@a.Specialization?.Name</td>
                                <td><span class="badge @bc">@s</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
