@model List<ClinicAPI.Models.DoctorProfile>
@{
    ViewData["Title"] = "Manage Doctors";
    var search = ViewBag.Search as string ?? "";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1>Doctors</h1>
        <p>@Model.Count doctor(s) found</p>
    </div>
</div>

<!-- Search -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="Doctors">
            <div class="row g-3 align-items-end">
                <div class="col-md-9">
                    <label class="form-label">Search</label>
                    <div class="input-group">
                        <span class="input-group-text" style="border-color:var(--border);">
                            <i class="bi bi-search" style="color:var(--text-light);"></i>
                        </span>
                        <input type="text" name="search" value="@search" class="form-control"
                               placeholder="Doctor name or license number…">
                    </div>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">Search</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Doctors Grid -->
@if (!Model.Any())
{
    <div class="card">
        <div class="text-center py-5">
            <i class="bi bi-people" style="font-size:2.5rem;color:var(--text-light);"></i>
            <p class="mt-3" style="color:var(--text-mid);">No doctors found.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var d in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div style="width:48px;height:48px;background:@(d.IsActive ? "var(--primary-light)" : "var(--surface)");border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-weight:700;color:@(d.IsActive ? "var(--primary)" : "var(--text-light)");font-size:18px;flex-shrink:0;">
                                @(d.AspNetUser?.FirstName?.Length > 0 ? d.AspNetUser.FirstName[0].ToString().ToUpper() : "D")
                            </div>
                            <div>
                                <div style="font-weight:700;font-size:15px;">
                                    Dr. @(d.AspNetUser?.FirstName ?? "—") @(d.AspNetUser?.LastName ?? "")
                                </div>
                                <div style="font-size:12px;color:var(--text-light);">@d.LicenseNumber</div>
                            </div>
                            <span class="badge @(d.IsActive ? "bg-success" : "bg-secondary") ms-auto">
                                @(d.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>

                        @if (d.DoctorSpecializations?.Any() == true)
                        {
                            <div class="d-flex flex-wrap gap-1 mb-3">
                                @foreach (var ds in d.DoctorSpecializations)
                                {
                                    <span class="badge" style="background:var(--primary-light);color:var(--primary);">
                                        @ds.Specialization?.Name
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <div style="font-size:12px;color:var(--text-light);margin-bottom:12px;">
                                No specializations assigned
                            </div>
                        }
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <a asp-action="DoctorDetails" asp-route-id="@d.DoctorId"
                           class="btn btn-sm btn-primary flex-fill">
                            <i class="bi bi-eye me-1"></i> Details
                        </a>
                        <a asp-action="ManageSchedule" asp-route-doctorId="@d.DoctorId"
                           class="btn btn-sm btn-outline-secondary flex-fill">
                            <i class="bi bi-calendar3 me-1"></i> Schedule
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
