@model ClinicMVC.ViewModels.UserViewModel

@{
    ViewData["Title"] = "Add New User";
}

<style>
    .user-type-toggle {
        background: #f8f9fa;
        border-radius: 0.75rem;
        overflow: hidden;
        border: 1px solid #e3e6ed;
    }
    .user-type-section {
        flex: 1 1 0;
        padding: 1.5rem 0;
        background: transparent;
        border: none;
        outline: none;
        transition: background 0.2s, color 0.2s, box-shadow 0.2s;
        font-size: 1.25rem;
        color: #495057;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-weight: 500;
        cursor: pointer;
        border-right: 1px solid #e3e6ed;
        min-width: 0;
        min-height: 80px;
        box-shadow: none;
    }
    .user-type-section:last-child {
        border-right: none;
    }
    .user-type-section.active, .user-type-section:focus {
        background: linear-gradient(90deg, #0d6efd 0%, #0dcaf0 100%);
        color: #fff;
        box-shadow: 0 2px 8px rgba(13,110,253,0.08);
        z-index: 1;
    }
    .user-type-section .bi {
        font-size: 2rem;
    }
</style>

<div class="container py-5">
    <div class="row mb-4">
        <div class="col text-center">
            <h2 class="fw-bold text-primary">@ViewData["Title"]</h2>
            <p class="text-muted fs-5">Choose the user type and fill in the required information below.</p>
        </div>
    </div>

    <div class="row justify-content-center mb-4">
        <div class="col-md-7">
            <div class="d-flex user-type-toggle mb-3 shadow-sm">
                <button id="doctorToggle" type="button" class="user-type-section active" onclick="showSection('doctor')" aria-pressed="true">
                    <span class="fs-4 me-2"><i class="bi bi-stethoscope"></i></span>
                    <span class="fw-semibold">Doctor</span>
                </button>
                <button id="receptionistToggle" type="button" class="user-type-section" onclick="showSection('receptionist')" aria-pressed="false">
                    <span class="fs-4 me-2"><i class="bi bi-person-badge"></i></span>
                    <span class="fw-semibold">Receptionist</span>
                </button>
            </div>

            <div id="doctorSection" style="display: block;">
                <div class="card border-0 shadow mb-4">
                    <div class="card-header bg-gradient-primary text-white d-flex align-items-center">
                        <i class="bi bi-stethoscope me-2 fs-4"></i>
                        <h5 class="mb-0 fw-semibold">Add Doctor</h5>
                    </div>
                    <div class="card-body">
                        <form id="userForm" asp-controller="ClinicManager" method="post" asp-action="AddNewUser" autocomplete="off" novalidate>
                            <div asp-validation-summary="All" class="alert alert-danger mb-4"></div>
                            @if (TempData["SuccessMessage"] != null)
                            {
                                <div class="alert alert-success mb-4">@TempData["SuccessMessage"]</div>
                            }

                            <input type="hidden" id="Role" name="Role" value="Doctor" />

                            <div class="row g-3">

                                <!-- Shared Fields -->
                                <div class="col-12">
                                    <label asp-for="Email" class="form-label">Email Address</label>
                                    <input asp-for="Email" type="email" class="form-control" name="Email" placeholder="Enter email" required/>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                         
                                </div>
                                
                                <div class="col-md-6">
                                    <label asp-for="FirstName" class="form-label">First Name</label>
                                    <input asp-for="FirstName" type="text" class="form-control" name="FirstName" placeholder="Enter first name" required />
                                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="LastName" class="form-label">Last Name</label>
                                    <input asp-for="LastName" type="text" class="form-control" name="LastName" placeholder="Enter last name" required />
                                    <span asp-validation-for="LastName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Password" class="form-label">Password</label>
                                    <input asp-for="Password" type="password" class="form-control" name="Password" placeholder="Enter password" required />
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control" name="ConfirmPassword" placeholder="Confirm password" required />
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>

                                <!-- Doctor Only -->

                                <div id="doctorFields">

                                    <div class="col-12">
                                        <label asp-for="LicenseNumber" class="form-label">License Number</label>

                                        <input asp-for="LicenseNumber" type="text" class="form-control" name="LicenseNumber" placeholder="Enter license number" required />
                                        <span asp-validation-for="LicenseNumber" class="text-danger small"></span>
                                    </div>
                                    <!---- Specialization  drop down list -->
                                   <div class="col-12 mt-3">
                                        <label asp-for="SpecializationId" class="form-label">Specialization</label>
                                        <select asp-for="SpecializationId" asp-items="ViewBag.Specializations" class="form-select" name="SpecializationId" required>
                                            <option value="">Select specialization</option>
                                            <!-- options dynamically -->

                                        </select>
                                        <span asp-validation-for="SpecializationId" class="text-danger small"></span>
                                    </div>
                                </div>


                            </div>

                            <div class="d-grid mt-4">
                                <button id="submitButton" type="submit" class="btn btn-primary btn-lg">
                                    Add Doctor
                                </button>
                            </div>

                        </form>
                        </div>


                        <script>

                            function showSection(section)
                            {
                                var doctorFields = document.getElementById('doctorFields');

                                var doctorToggle = document.getElementById('doctorToggle');

                                var receptionistToggle = document.getElementById('receptionistToggle');

                                var submitButton = document.getElementById('submitButton');

                                var form = document.getElementById('userForm');

                                var roleInput = document.getElementById('Role');

                                if(section === 'doctor')
                                {
                                    doctorFields.style.display = 'block';

                                    doctorToggle.classList.add('active');

                                    receptionistToggle.classList.remove('active');

                                    submitButton.innerText = 'Add Doctor';


                                    roleInput.value = 'Doctor';
                                }
                                else
                                {
                                    doctorFields.style.display = 'none';

                                    receptionistToggle.classList.add('active');

                                    doctorToggle.classList.remove('active');

                                    submitButton.innerText = 'Add Receptionist';


                                    roleInput.value = 'Receptionist';
                                }
                            }

                        </script>

    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
                    }
