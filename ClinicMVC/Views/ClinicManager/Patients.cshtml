@model List<ClinicAPI.Models.PatientProfile>
@{
    ViewData["Title"] = "Patients";
    var search = ViewBag.Search as string ?? "";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1>Patients</h1>
        <p>@Model.Count patient(s) found</p>
    </div>
</div>


<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="Patients">
            <div class="row g-3 align-items-end">
                <div class="col-md-9">
                    <label class="form-label">Search</label>
                    <div class="input-group">
                        <span class="input-group-text" style="border-color:var(--border);">
                            <i class="bi bi-search" style="color:var(--text-light);"></i>
                        </span>
                        <input type="text" name="search" value="@search" class="form-control"
                               placeholder="Patient name, CPR, or reference number…">
                    </div>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">Search</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-person-x" style="font-size:2.5rem;color:var(--text-light);"></i>
                <p class="mt-3" style="color:var(--text-mid);">No patients found.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Patient</th>
                            <th>CPR</th>
                            <th>Reference</th>
                            <th>Date of Birth</th>
                            <th>Blood Type</th>
                            <th>Gender</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>
                                    <div style="font-weight:600;font-size:14px;">
                                        @(p.AspNetUser?.FirstName ?? "—") @(p.AspNetUser?.LastName ?? "")
                                    </div>
                                    <div style="font-size:12px;color:var(--text-light);">@(p.AspNetUser?.Email ?? "")</div>
                                </td>
                                <td style="font-family:var(--font-display);font-size:13px;">@p.Cprnumber</td>
                                <td style="font-size:13px;color:var(--text-mid);">@p.PatientReferenceNumber</td>
                                <td style="font-size:13px;">@p.DateOfBirth.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(p.BloodType))
                                    { <span class="badge bg-danger">@p.BloodType</span> }
                                    else { <span style="color:var(--text-light);">—</span> }
                                </td>
                                <td style="font-size:13px;">@(p.Gender ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
