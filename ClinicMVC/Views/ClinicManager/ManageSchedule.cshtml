@{
    ViewData["Title"] = "Manage Schedule";
    var doctor    = ViewBag.Doctor   as ClinicAPI.Models.DoctorProfile;
    var schedules = ViewBag.Schedules as List<ClinicAPI.Models.DoctorSchedule>
                    ?? new List<ClinicAPI.Models.DoctorSchedule>();
    string DayName(int d) => d switch { 0=>"Sunday",1=>"Monday",2=>"Tuesday",3=>"Wednesday",4=>"Thursday",5=>"Friday",6=>"Saturday",_=>$"Day {d}" };
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1>Manage Schedule</h1>
        <p>Dr. @(doctor?.AspNetUser?.FirstName ?? "—") @(doctor?.AspNetUser?.LastName ?? "")</p>
    </div>
    <a asp-action="DoctorDetails" asp-route-id="@doctor?.DoctorId" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>
</div>

<div class="row g-4">
    
    <div class="col-lg-4">
        <div class="card" style="position:sticky;top:80px;">
            <div class="card-header"><i class="bi bi-plus-circle me-2"></i>Add / Update Day</div>
            <div class="card-body">
                <form asp-action="SaveSchedule" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="doctorId" value="@doctor?.DoctorId" />

                    <div class="mb-3">
                        <label class="form-label">Day of Week</label>
                        <select name="dayOfWeek" class="form-select" required>
                            @for (int i = 0; i < 7; i++)
                            {
                                <option value="@i">@DayName(i)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Start Time</label>
                        <input type="time" name="startTime" class="form-control" value="08:00" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">End Time</label>
                        <input type="time" name="endTime" class="form-control" value="17:00" required />
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Slot Duration</label>
                        <select name="slotDurationMinutes" class="form-select" required>
                            <option value="15">15 minutes</option>
                            <option value="20">20 minutes</option>
                            <option value="30" selected>30 minutes</option>
                            <option value="45">45 minutes</option>
                            <option value="60">60 minutes</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-save me-1"></i> Save Schedule
                    </button>
                </form>
                <div class="alert alert-info mt-3 mb-0" style="font-size:12px;">
                    <i class="bi bi-info-circle me-1"></i>
                    If a schedule already exists for the selected day, it will be updated.
                </div>
            </div>
        </div>
    </div>

   
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header"><i class="bi bi-calendar3 me-2"></i>Current Weekly Schedule</div>
            <div class="card-body p-0">
                @if (!schedules.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-calendar-x" style="font-size:2.5rem;color:var(--text-light);"></i>
                        <p class="mt-3" style="color:var(--text-mid);">No schedule set yet. Add working days using the form.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr><th>Day</th><th>Hours</th><th>Slot Duration</th><th>Status</th><th></th></tr>
                            </thead>
                            <tbody>
                                @for (int day = 0; day < 7; day++)
                                {
                                    var s = schedules.FirstOrDefault(x => x.DayOfWeek == day);
                                    <tr style="@(s == null ? "opacity:.4;" : "")">
                                        <td style="font-weight:600;font-size:13px;">@DayName(day)</td>
                                        @if (s == null)
                                        {
                                            <td colspan="3" style="font-size:13px;font-style:italic;color:var(--text-light);">Day off</td>
                                            <td></td>
                                        }
                                        else
                                        {
                                            <td style="font-size:13px;font-weight:500;">
                                                @s.StartTime.ToString("HH\\:mm") – @s.EndTime.ToString("HH\\:mm")
                                            </td>
                                            <td style="font-size:13px;">@s.SlotDurationMinutes min</td>
                                            <td>
                                                <span class="badge @(s.IsActive ? "bg-success" : "bg-secondary")">
                                                    @(s.IsActive ? "Active" : "Inactive")
                                                </span>
                                            </td>
                                            <td>
                                                <form asp-action="DeleteSchedule" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="scheduleId" value="@s.ScheduleId" />
                                                    <input type="hidden" name="doctorId" value="@doctor?.DoctorId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                                            onclick="return confirm('Remove this schedule day?')">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
