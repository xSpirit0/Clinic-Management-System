@model ClinicAPI.Models.ApplicationUser
@{
    ViewData["Title"] = "Edit Staff Member";
    var role = ViewBag.Role as string ?? "";
    var doctorProfile = ViewBag.DoctorProfile as ClinicAPI.Models.DoctorProfile;
}

<div class="mb-4">
    <a asp-action="StaffManagement" class="text-decoration-none" style="color:var(--text-mid);font-size:14px;">
        <i class="bi bi-arrow-left me-1"></i>Back to Staff Management
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card" style="border-radius:var(--radius);border:1px solid var(--border);">
            <div class="card-header" style="background:var(--white);border-bottom:1px solid var(--border);padding:20px 24px;border-radius:var(--radius) var(--radius) 0 0;">
                <div class="d-flex align-items-center gap-3">
                    <div style="width:44px;height:44px;border-radius:50%;background:var(--primary-light);color:var(--primary);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:16px;">
                        @Model.FirstName[0]@Model.LastName[0]
                    </div>
                    <div>
                        <h5 class="mb-0" style="font-family:var(--font-display);font-weight:600;">
                            Edit @(role == "Doctor" ? "Dr. " : "")@Model.FirstName @Model.LastName
                        </h5>
                        <span class="badge" style="font-size:11px;@(role == "Doctor" ? "background:#e3f2fd;color:#1565c0;" : "background:#fff3e0;color:#e65100;")">
                            @role
                        </span>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Error"]
                    </div>
                }

                @* Read-only email notice *@
                <div class="alert" style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);">
                    <div class="d-flex align-items-center gap-2" style="font-size:13px;color:var(--text-mid);">
                        <i class="bi bi-lock-fill text-primary"></i>
                        <span>
                            <strong>Login email:</strong> @Model.Email
                            <span class="ms-2 text-muted">(cannot be changed — it is the login credential)</span>
                        </span>
                    </div>
                </div>

                <form asp-action="EditStaff" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="firstName" class="form-label" style="font-size:14px;font-weight:500;">
                                First Name <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="firstName" name="firstName"
                                   value="@Model.FirstName" required />
                        </div>
                        <div class="col-md-6">
                            <label for="lastName" class="form-label" style="font-size:14px;font-weight:500;">
                                Last Name <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="lastName" name="lastName"
                                   value="@Model.LastName" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="phoneNumber" class="form-label" style="font-size:14px;font-weight:500;">
                            Phone Number <span class="text-danger">*</span>
                        </label>
                        <input type="tel" class="form-control" id="phoneNumber" name="phoneNumber"
                               value="@Model.PhoneNumber" required />
                    </div>

                    @* Doctor-only fields *@
                    @if (role == "Doctor" && doctorProfile != null)
                    {
                        <hr style="border-color:var(--border);" />
                        <p class="text-muted mb-3" style="font-size:13px;">
                            <i class="bi bi-info-circle me-1"></i>Doctor profile details
                        </p>

                        <div class="mb-3">
                            <label for="licenseNumber" class="form-label" style="font-size:14px;font-weight:500;">
                                License Number <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="licenseNumber" name="licenseNumber"
                                   value="@doctorProfile.LicenseNumber" required />
                        </div>

                        <div class="mb-3">
                            <label for="biography" class="form-label" style="font-size:14px;font-weight:500;">Biography</label>
                            <textarea class="form-control" id="biography" name="biography" rows="3">@doctorProfile.Biography</textarea>
                        </div>
                    }

                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" class="btn-primary-clinic">
                            <i class="bi bi-check-circle-fill"></i> Save Changes
                        </button>
                        <a asp-action="StaffManagement" class="btn-outline-clinic">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
