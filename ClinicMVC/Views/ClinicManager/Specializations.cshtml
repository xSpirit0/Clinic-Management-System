@model List<ClinicAPI.Models.Specialization>
@{
    ViewData["Title"] = "Specializations";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="page-header">
    <h1>Specializations</h1>
    <p>Manage the medical specializations offered at the clinic</p>
</div>

<div class="row g-4">
    
    <div class="col-lg-4">
        <div class="card" style="position:sticky;top:80px;">
            <div class="card-header"><i class="bi bi-plus-circle me-2"></i>Add Specialization</div>
            <div class="card-body">
                <form asp-action="AddNewSpecialization" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Name *</label>
                        <input type="text" name="name" class="form-control" required
                               placeholder="e.g. Cardiology" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Description</label>
                        <textarea name="description" class="form-control" rows="2"
                                  placeholder="Brief description…"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-plus-circle me-1"></i> Add Specialization
                    </button>
                </form>
            </div>
        </div>
    </div>

    
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-award me-2"></i>All Specializations
                <span class="badge bg-primary ms-2">@Model.Count</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-award" style="font-size:2.5rem;color:var(--text-light);"></i>
                        <p class="mt-3" style="color:var(--text-mid);">No specializations yet. Add one using the form.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr><th>Name</th><th>Description</th><th>Doctors</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model)
                                {
                                    var doctorCount = s.DoctorSpecializations?.Count ?? 0;
                                    <tr>
                                        <td style="font-weight:600;font-size:14px;">@s.Name</td>
                                        <td style="font-size:13px;color:var(--text-mid);">
                                            @(string.IsNullOrWhiteSpace(s.Description) ? "—" : s.Description)
                                        </td>
                                        <td>
                                            <span class="badge @(doctorCount > 0 ? "bg-primary" : "bg-secondary")">
                                                @doctorCount doctor(s)
                                            </span>
                                        </td>
                                        <td>
                                            @if (doctorCount == 0)
                                            {
                                                <form asp-action="DeleteSpecialization" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@s.SpecializationId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                                            onclick="return confirm('Delete @s.Name?')">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span style="font-size:12px;color:var(--text-light);" title="Cannot delete — assigned to doctors">
                                                    <i class="bi bi-lock"></i>
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
