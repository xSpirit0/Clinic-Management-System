@model ClinicAPI.Models.Appointment
@{
    ViewData["Title"] = "Appointment Details";
    var status = Model.AppointmentStatus.AppointmentStatus1;
    var bc = status switch {
        "Requested"  => "bg-secondary",
        "Confirmed"  => "bg-primary",
        "CheckedIn"  => "bg-info",
        "InProgress" => "bg-warning text-dark",
        "Completed"  => "bg-success",
        "Cancelled"  => "bg-danger",
        "Missed"     => "bg-dark",
        _            => "bg-secondary"
    };
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1>Appointment #@Model.AppointmentId</h1>
        <p>@Model.ScheduledDate.ToString("dddd, dd MMMM yyyy") · @Model.SlotStartTime.ToString("HH\\:mm") – @Model.SlotEndTime.ToString("HH\\:mm")</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="badge @bc" style="font-size:13px;padding:7px 14px;">@status</span>
        <a asp-action="MyAppointments" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <!-- Appointment Info -->
        <div class="card mb-4">
            <div class="card-header"><i class="bi bi-info-circle me-2"></i>Appointment Info</div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var (lbl, val) in new (string,string)[] {
                        ("Date",           Model.ScheduledDate.ToString("dddd, dd MMMM yyyy")),
                        ("Time",           Model.SlotStartTime.ToString("HH\\:mm") + " – " + Model.SlotEndTime.ToString("HH\\:mm")),
                        ("Doctor",         "Dr. " + (Model.Doctor?.AspNetUser?.FirstName ?? "—") + " " + (Model.Doctor?.AspNetUser?.LastName ?? "")),
                        ("Specialization", Model.Specialization?.Name ?? "—"),
                        ("Booked On",      Model.CreatedAt.ToString("dd MMM yyyy, HH\\:mm")),
                    })
                    {
                        <div class="col-sm-6">
                            <div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">@lbl</div>
                            <div style="font-weight:500;font-size:14px;">@val</div>
                        </div>
                    }
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <div class="col-sm-6">
                            <div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">Last Updated</div>
                            <div style="font-weight:500;font-size:14px;">@Model.UpdatedAt.Value.ToString("dd MMM yyyy, HH\\:mm")</div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.ComplaintReason))
                    {
                        <div class="col-12">
                            <div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">Complaint / Reason</div>
                            <div style="font-size:14px;">@Model.ComplaintReason</div>
                        </div>
                    }
                </div>
            </div>
            @if (status == "Requested" || status == "Confirmed")
            {
                <div class="card-footer text-end">
                    <a asp-action="CancelAppointment" asp-route-id="@Model.AppointmentId"
                       class="btn btn-outline-danger">
                        <i class="bi bi-x-circle me-1"></i> Cancel Appointment
                    </a>
                </div>
            }
        </div>

        <!-- Visit Record -->
        @if (Model.VisitRecord != null)
        {
            <div class="card mb-4">
                <div class="card-header"><i class="bi bi-file-earmark-medical me-2"></i>Visit Record</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">Visit Date</div>
                            <div style="font-weight:500;">@Model.VisitRecord.VisitDate.ToString("dd MMM yyyy, HH\\:mm")</div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.VisitRecord.Diagnosis))
                        {
                            <div class="col-12">
                                <div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">Diagnosis</div>
                                <div style="font-size:14px;">@Model.VisitRecord.Diagnosis</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.VisitRecord.Treatment))
                        {
                            <div class="col-12">
                                <div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">Treatment</div>
                                <div style="font-size:14px;">@Model.VisitRecord.Treatment</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.VisitRecord.DoctorNotes))
                        {
                            <div class="col-12">
                                <div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">Doctor's Notes</div>
                                <div style="font-size:14px;">@Model.VisitRecord.DoctorNotes</div>
                            </div>
                        }
                    </div>
                    <div class="mt-3">
                        <a asp-action="VisitRecordDetails" asp-route-id="@Model.VisitRecord.VisitRecordId"
                           class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-eye me-1"></i> Full Visit Record
                        </a>
                    </div>
                </div>
            </div>

            @if (Model.VisitRecord.Prescriptions?.Any() == true)
            {
                <div class="card">
                    <div class="card-header"><i class="bi bi-capsule me-2"></i>Prescriptions from this Visit</div>
                    <div class="card-body p-0">
                        @foreach (var pres in Model.VisitRecord.Prescriptions)
                        {
                            <div class="d-flex justify-content-between align-items-center px-4 py-3"
                                 style="border-bottom:1px solid var(--border);">
                                <div>
                                    <div style="font-weight:600;font-size:14px;">Prescription #@pres.PrescriptionId</div>
                                    <div style="font-size:12px;color:var(--text-light);">
                                        Issued @pres.IssuedAt.ToString("dd MMM yyyy") · @(pres.PrescriptionItems?.Count ?? 0) item(s)
                                    </div>
                                </div>
                                <a asp-action="PrescriptionDetails" asp-route-id="@pres.PrescriptionId"
                                   class="btn btn-sm btn-outline-primary">View</a>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else if (status == "Completed")
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                This appointment is completed but no visit record has been added yet.
            </div>
        }
    </div>

    <!-- Sidebar quick links -->
    <div class="col-lg-4">
        <div class="card" style="position:sticky;top:80px;">
            <div class="card-header"><i class="bi bi-lightning me-2"></i>Quick Links</div>
            <div class="card-body d-flex flex-column gap-2">
                <a asp-action="MyAppointments" class="btn btn-outline-primary w-100 text-start">
                    <i class="bi bi-calendar2 me-2"></i> All Appointments
                </a>
                <a asp-action="MedicalHistory" class="btn btn-outline-primary w-100 text-start">
                    <i class="bi bi-file-earmark-medical me-2"></i> Medical History
                </a>
                <a asp-action="MyPrescriptions" class="btn btn-outline-primary w-100 text-start">
                    <i class="bi bi-capsule me-2"></i> My Prescriptions
                </a>
                <a asp-action="BookAppointment" class="btn btn-primary w-100 text-start">
                    <i class="bi bi-plus-circle me-2"></i> Book New Appointment
                </a>
            </div>
        </div>
    </div>
</div>
