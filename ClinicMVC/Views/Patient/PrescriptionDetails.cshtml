@model ClinicAPI.Models.Prescription

@{
    ViewData["Title"] = "Prescription Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Prescription #@Model.PrescriptionId</h1>
        <a asp-action="MyPrescriptions" class="btn btn-outline-secondary">← Back</a>
    </div>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Prescription Information</h5>
            @{
                @* ⚠️ Assumed: PrescriptionStatus.PrescriptionStatus1 *@
                var status = Model.PrescriptionStatus?.PrescriptionStatus1 ?? "Unknown";
                var badgeClass = status switch
                {
                    "Active" => "bg-success",
                    "Completed" => "bg-secondary",
                    "Cancelled" => "bg-danger",
                    _ => "bg-light text-dark"
                };
            }
            <span class="badge @badgeClass fs-6">@status</span>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <small class="text-muted d-block">Issued On</small>
                    <strong>@Model.IssuedAt.ToString("dddd, dd MMMM yyyy HH:mm")</strong>
                </div>
                <div class="col-md-6 mb-3">
                    <small class="text-muted d-block">Prescribed By</small>
                    <strong>@(Model.VisitRecord?.Doctor?.AspNetUser?.FirstName ?? "—")</strong>
                </div>
                @if (Model.VisitRecord?.Appointment != null)
                {
                    <div class="col-md-6">
                        <small class="text-muted d-block">From Visit</small>
                        <a asp-action="VisitRecordDetails" asp-route-id="@Model.VisitRecord.VisitRecordId">
                            View visit on @Model.VisitRecord.VisitDate.ToString("dd MMM yyyy")
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Medications (@(Model.PrescriptionItems?.Count ?? 0))</h5>
        </div>
        @if (Model.PrescriptionItems == null || !Model.PrescriptionItems.Any())
        {
            <div class="card-body text-center text-muted p-4">
                No medications listed in this prescription.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Medication</th>
                            <th>Dosage</th>
                            <th>Frequency</th>
                            <th>Duration</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* ⚠️ Property names assumed: MedicationName, Dosage, Frequency, Duration.
                           If the scaffolded entity uses different names, adjust here. *@
                        @foreach (var item in Model.PrescriptionItems)
                        {
                            <tr>
                                <td><strong>@item.MedicationName</strong></td>
                                <td>@(item.Dosage ?? "—")</td>
                                <td>@(item.Frequency ?? "—")</td>
                                
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="alert alert-info mt-4 mb-0">
        <small>
            <strong>Important:</strong> Always follow your doctor's instructions.
            Do not stop, change, or share your medication without consulting your doctor first.
        </small>
    </div>

</div>
