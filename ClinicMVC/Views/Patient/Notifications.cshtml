@model IEnumerable<ClinicAPI.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
}

<div class="container mt-4">

    <h1 class="mb-1">Notifications</h1>
    <p class="text-muted mb-4">Updates about your appointments and prescriptions.</p>

    @if (!Model.Any())
    {
        <div class="card">
            <div class="card-body text-center p-5">
                <h5 class="text-muted">No notifications</h5>
                <p class="mb-0">You're all caught up!</p>
            </div>
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var n in Model)
            {
                <div class="list-group-item @(n.IsRead ? "" : "list-group-item-light border-start border-primary border-3")">
                    <div class="d-flex w-100 justify-content-between">
                        <h6 class="mb-1">
                            @if (!n.IsRead)
                            {
                                <span class="badge bg-primary me-2">NEW</span>
                            }
                            @n.Title
                        </h6>
                        <small class="text-muted">@n.CreatedAt.ToString("dd MMM HH:mm")</small>
                    </div>
                    <p class="mb-1">@n.Message</p>
                    @if (n.AppointmentId.HasValue)
                    {
                        <small>
                            <a asp-action="AppointmentDetails" asp-route-id="@n.AppointmentId">
                                View related appointment →
                            </a>
                        </small>
                    }
                </div>
            }
        </div>
    }

    <div class="mt-3">
        <a asp-action="Dashboard" class="btn btn-link">← Back to Dashboard</a>
    </div>

</div>
