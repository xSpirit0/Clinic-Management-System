@model IEnumerable<ClinicAPI.Models.Prescription>

@{
    ViewData["Title"] = "My Prescriptions";
}

<div class="container mt-4">

    <h1 class="mb-1">My Prescriptions</h1>
    <p class="text-muted mb-4">All medications prescribed to you.</p>

    @if (!Model.Any())
    {
        <div class="card">
            <div class="card-body text-center p-5">
                <h5 class="text-muted">No prescriptions yet</h5>
                <p class="mb-0">Prescriptions written by your doctors will appear here.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Issued</th>
                                <th>Doctor</th>
                                <th>Items</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td>@p.IssuedAt.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @(p.VisitRecord?.Doctor?.AspNetUser?.FirstName ?? "—")
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">
                                            @(p.PrescriptionItems?.Count ?? 0)
                                        </span>
                                        medication(s)
                                    </td>
                                    <td>
                                        @* ⚠️ Assumed: PrescriptionStatus.PrescriptionStatus1 *@
                                        @{
                                            var status = p.PrescriptionStatus?.PrescriptionStatus1 ?? "Unknown";
                                            var badgeClass = status switch
                                            {
                                                "Active" => "bg-success",
                                                "Completed" => "bg-secondary",
                                                "Cancelled" => "bg-danger",
                                                _ => "bg-light text-dark"
                                            };
                                        }
                                        <span class="badge @badgeClass">@status</span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="PrescriptionDetails" asp-route-id="@p.PrescriptionId"
                                           class="btn btn-sm btn-outline-primary">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="mt-3">
        <a asp-action="Dashboard" class="btn btn-link">← Back to Dashboard</a>
    </div>

</div>
