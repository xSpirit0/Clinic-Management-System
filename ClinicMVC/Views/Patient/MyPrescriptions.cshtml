@model IEnumerable<ClinicAPI.Models.Prescription>
@{
    ViewData["Title"] = "My Prescriptions";
}

<div class="page-header">
    <h1>My Prescriptions</h1>
    <p>All medications prescribed to you</p>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-capsule" style="font-size:2.5rem;color:var(--text-light);"></i>
                <p class="mt-3 mb-1" style="color:var(--text-mid);font-weight:500;">No prescriptions yet</p>
                <p style="font-size:13px;color:var(--text-light);">Prescriptions from your doctors will appear here.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Issued</th>
                            <th>Doctor</th>
                            <th>Medications</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            var status = p.PrescriptionStatus?.PrescriptionStatus1 ?? "Unknown";
                            var bc = status switch {
                                "Active"    => "bg-success",
                                "Completed" => "bg-secondary",
                                "Cancelled" => "bg-danger",
                                _           => "bg-secondary"
                            };
                            <tr>
                                <td style="font-weight:600;font-size:13px;">@p.IssuedAt.ToString("dd MMM yyyy")</td>
                                <td style="font-size:13px;">Dr. @(p.VisitRecord?.Doctor?.AspNetUser?.FirstName ?? "—") @(p.VisitRecord?.Doctor?.AspNetUser?.LastName ?? "")</td>
                                <td>
                                    <span class="badge bg-primary">@(p.PrescriptionItems?.Count ?? 0)</span>
                                    <span style="font-size:13px;color:var(--text-mid);"> medication(s)</span>
                                </td>
                                <td><span class="badge @bc">@status</span></td>
                                <td class="text-end">
                                    <a asp-action="PrescriptionDetails" asp-route-id="@p.PrescriptionId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
