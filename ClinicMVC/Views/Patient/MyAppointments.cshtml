@model IEnumerable<ClinicAPI.Models.Appointment>
@{
    ViewData["Title"] = "My Appointments";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1>My Appointments</h1>
        <p>@Model.Count() appointment(s) total</p>
    </div>
    <a asp-action="BookAppointment" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Book New
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x" style="font-size:2.5rem;color:var(--text-light);"></i>
                <p class="mt-3 mb-2" style="color:var(--text-mid);font-weight:500;">No appointments yet</p>
                <a asp-action="BookAppointment" class="btn btn-sm btn-primary">Book Your First Appointment</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Doctor</th>
                            <th>Specialization</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model)
                        {
                            var status = appt.AppointmentStatus.AppointmentStatus1;
                            var bc = status switch {
                                "Requested"  => "bg-secondary",
                                "Confirmed"  => "bg-primary",
                                "CheckedIn"  => "bg-info",
                                "InProgress" => "bg-warning text-dark",
                                "Completed"  => "bg-success",
                                "Cancelled"  => "bg-danger",
                                "Missed"     => "bg-dark",
                                _            => "bg-secondary"
                            };
                            <tr>
                                <td style="font-weight:600;font-size:13px;">@appt.ScheduledDate.ToString("ddd, dd MMM yyyy")</td>
                                <td style="font-size:13px;color:var(--text-mid);">@appt.SlotStartTime.ToString("HH\\:mm") – @appt.SlotEndTime.ToString("HH\\:mm")</td>
                                <td style="font-size:13px;">Dr. @(appt.Doctor?.AspNetUser?.FirstName ?? "—") @(appt.Doctor?.AspNetUser?.LastName ?? "")</td>
                                <td style="font-size:13px;">@(appt.Specialization?.Name ?? "—")</td>
                                <td><span class="badge @bc">@status</span></td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <a asp-action="AppointmentDetails" asp-route-id="@appt.AppointmentId"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i> Details
                                        </a>
                                        @if (status == "Requested" || status == "Confirmed")
                                        {
                                            <a asp-action="CancelAppointment" asp-route-id="@appt.AppointmentId"
                                               class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-x-circle me-1"></i> Cancel
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
