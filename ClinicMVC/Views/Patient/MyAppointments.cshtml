@model IEnumerable<ClinicAPI.Models.Appointment>

@{
    ViewData["Title"] = "My Appointments";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>My Appointments</h1>
        <a asp-action="BookAppointment" class="btn btn-primary">+ Book New</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card">
            <div class="card-body text-center p-5">
                <h5 class="text-muted">No appointments yet</h5>
                <p class="mb-3">You haven't booked any appointments.</p>
                <a asp-action="BookAppointment" class="btn btn-primary">
                    Book Your First Appointment
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Doctor</th>
                                <th>Specialization</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in Model)
                            {
                                <tr>
                                    <td>@appt.ScheduledDate.ToString("ddd, dd MMM yyyy")</td>
                                    <td>
                                        @appt.SlotStartTime.ToString("HH:mm") -
                                        @appt.SlotEndTime.ToString("HH:mm")
                                    </td>
                                    <td>@(appt.Doctor?.AspNetUser?.FirstName ?? "—")</td>
                                    @* ⚠️ Assumed property: Specialization.SpecializationName *@
                                    <td>@(appt.Specialization?.Name ?? "—")</td>
                                    <td>
                                        @{
                                            var status = appt.AppointmentStatus.AppointmentStatus1;
                                            var badgeClass = status switch
                                            {
                                                "Requested" => "bg-warning text-dark",
                                                "Confirmed" => "bg-info text-dark",
                                                "CheckedIn" => "bg-primary",
                                                "InProgress" => "bg-primary",
                                                "Completed" => "bg-success",
                                                "Cancelled" => "bg-danger",
                                                "Missed" => "bg-secondary",
                                                _ => "bg-light text-dark"
                                            };
                                        }
                                        <span class="badge @badgeClass">@status</span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="AppointmentDetails"
                                           asp-route-id="@appt.AppointmentId"
                                           class="btn btn-sm btn-outline-primary">Details</a>

                                        @if (status == "Requested" || status == "Confirmed")
                                        {
                                            <a asp-action="CancelAppointment"
                                               asp-route-id="@appt.AppointmentId"
                                               class="btn btn-sm btn-outline-danger">Cancel</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="mt-3">
        <a asp-action="Dashboard" class="btn btn-link">← Back to Dashboard</a>
    </div>

</div>
