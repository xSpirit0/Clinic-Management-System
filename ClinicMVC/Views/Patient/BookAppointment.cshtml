@{
    ViewData["Title"] = "Book Appointment";
    var specializations = ViewBag.Specializations as List<ClinicAPI.Models.Specialization>
                          ?? new List<ClinicAPI.Models.Specialization>();
    var minDate = DateTime.Today.ToString("yyyy-MM-dd");
    var maxDate = DateTime.Today.AddMonths(3).ToString("yyyy-MM-dd");
}

<div class="container mt-4">

    <h1 class="mb-1">Book an Appointment</h1>
    <p class="text-muted mb-4">Follow the steps below to book an appointment.</p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="BookAppointment" method="post" id="bookForm">
        @Html.AntiForgeryToken()

        @* hidden fields populated by the form steps *@
        <input type="hidden" name="slotStartTime" id="slotStartTime" />
        <input type="hidden" name="slotEndTime" id="slotEndTime" />

        <div class="card mb-3">
            <div class="card-header">
                <strong>Step 1:</strong> Choose Specialization
            </div>
            <div class="card-body">
                <select name="specializationId" id="specializationId" class="form-select" required>
                    <option value="">-- Select a specialization --</option>
                    @* ⚠️ Assumed: Specialization.SpecializationName *@
                    @foreach (var s in specializations)
                    {
                        <option value="@s.SpecializationId">@s.Name</option>
                    }
                </select>
                @if (!specializations.Any())
                {
                    <small class="text-danger">
                        No specializations available. Please contact the clinic.
                    </small>
                }
            </div>
        </div>

        <div class="card mb-3" id="step2Card" style="display:none;">
            <div class="card-header">
                <strong>Step 2:</strong> Choose Doctor
            </div>
            <div class="card-body">
                <select name="doctorId" id="doctorId" class="form-select" required>
                    <option value="">-- Select a doctor --</option>
                </select>
                <div id="doctorLoading" class="text-muted mt-2" style="display:none;">
                    <small>Loading doctors...</small>
                </div>
            </div>
        </div>

        <div class="card mb-3" id="step3Card" style="display:none;">
            <div class="card-header">
                <strong>Step 3:</strong> Choose Date
            </div>
            <div class="card-body">
                <input type="date" name="scheduledDate" id="scheduledDate"
                       class="form-control"
                       min="@minDate" max="@maxDate" required />
                <small class="form-text text-muted">
                    You can book up to 3 months in advance.
                </small>
            </div>
        </div>

        <div class="card mb-3" id="step4Card" style="display:none;">
            <div class="card-header">
                <strong>Step 4:</strong> Choose Time Slot
            </div>
            <div class="card-body">
                <div id="slotsLoading" class="text-muted" style="display:none;">
                    <small>Checking availability...</small>
                </div>
                <div id="slotsContainer" class="d-flex flex-wrap gap-2"></div>
                <div id="noSlotsMessage" class="alert alert-warning mb-0" style="display:none;">
                    No available slots for the selected date.
                    The doctor may be off, on leave, or fully booked. Please pick another date.
                </div>
            </div>
        </div>

        <div class="card mb-3" id="step5Card" style="display:none;">
            <div class="card-body">
                <div class="alert alert-info" id="bookingSummary"></div>
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">
                        Confirm Booking
                    </button>
                </div>
            </div>
        </div>

    </form>

</div>

@section Scripts {
    <script>
        const specSelect = document.getElementById('specializationId');
        const doctorSelect = document.getElementById('doctorId');
        const dateInput = document.getElementById('scheduledDate');
        const slotsContainer = document.getElementById('slotsContainer');
        const noSlotsMessage = document.getElementById('noSlotsMessage');
        const doctorLoading = document.getElementById('doctorLoading');
        const slotsLoading = document.getElementById('slotsLoading');
        const slotStartTime = document.getElementById('slotStartTime');
        const slotEndTime = document.getElementById('slotEndTime');

        const step2 = document.getElementById('step2Card');
        const step3 = document.getElementById('step3Card');
        const step4 = document.getElementById('step4Card');
        const step5 = document.getElementById('step5Card');

        function resetFromStep(stepNum) {
            if (stepNum <= 2) {
                doctorSelect.innerHTML = '<option value="">-- Select a doctor --</option>';
                step2.style.display = 'none';
            }
            if (stepNum <= 3) {
                dateInput.value = '';
                step3.style.display = 'none';
            }
            if (stepNum <= 4) {
                slotsContainer.innerHTML = '';
                noSlotsMessage.style.display = 'none';
                slotStartTime.value = '';
                slotEndTime.value = '';
                step4.style.display = 'none';
            }
            step5.style.display = 'none';
        }

        // STEP 1 -> STEP 2: load doctors when specialization picked
        specSelect.addEventListener('change', async function () {
            resetFromStep(2);
            const specId = this.value;
            if (!specId) return;

            step2.style.display = 'block';
            doctorLoading.style.display = 'block';

            try {
                const res = await fetch(`@Url.Action("GetDoctorsBySpecialization")?specializationId=${specId}`);
                const doctors = await res.json();
                doctorLoading.style.display = 'none';

                if (doctors.length === 0) {
                    doctorSelect.innerHTML = '<option value="">No doctors available</option>';
                    return;
                }

                doctors.forEach(d => {
                    const opt = document.createElement('option');
                    opt.value = d.id;
                    opt.textContent = d.name;
                    doctorSelect.appendChild(opt);
                });
            } catch (err) {
                doctorLoading.style.display = 'none';
                alert('Could not load doctors. Please try again.');
            }
        });

        // STEP 2 -> STEP 3: show date picker when doctor picked
        doctorSelect.addEventListener('change', function () {
            resetFromStep(3);
            if (this.value) {
                step3.style.display = 'block';
            }
        });

        // STEP 3 -> STEP 4: load slots when date picked
        dateInput.addEventListener('change', async function () {
            resetFromStep(4);
            const doctorId = doctorSelect.value;
            const date = this.value;
            if (!doctorId || !date) return;

            step4.style.display = 'block';
            slotsLoading.style.display = 'block';

            try {
                const res = await fetch(`@Url.Action("GetAvailableSlots")?doctorId=${doctorId}&date=${date}`);
                const slots = await res.json();
                slotsLoading.style.display = 'none';

                if (slots.length === 0) {
                    noSlotsMessage.style.display = 'block';
                    return;
                }

                slots.forEach(slot => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'btn btn-outline-primary';
                    btn.textContent = slot.display;
                    btn.onclick = () => selectSlot(btn, slot);
                    slotsContainer.appendChild(btn);
                });
            } catch (err) {
                slotsLoading.style.display = 'none';
                alert('Could not load available slots. Please try again.');
            }
        });

        // STEP 4 -> STEP 5: select a slot
        function selectSlot(button, slot) {
            slotsContainer.querySelectorAll('button').forEach(b => {
                b.classList.remove('btn-primary');
                b.classList.add('btn-outline-primary');
            });
            button.classList.remove('btn-outline-primary');
            button.classList.add('btn-primary');

            slotStartTime.value = slot.startTime;
            slotEndTime.value = slot.endTime;

            const spec = specSelect.options[specSelect.selectedIndex].text;
            const doc = doctorSelect.options[doctorSelect.selectedIndex].text;
            const dateStr = new Date(dateInput.value).toLocaleDateString('en-GB', {
                weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
            });

            document.getElementById('bookingSummary').innerHTML =
                `<strong>Confirm your booking:</strong><br>` +
                `${spec} with ${doc}<br>` +
                `${dateStr} at ${slot.display}`;

            step5.style.display = 'block';
        }
    </script>
}
