@{
    ViewData["Title"] = "My Dashboard";
    var upcoming = ViewBag.UpcomingAppointments as List<ClinicAPI.Models.Appointment>
                   ?? new List<ClinicAPI.Models.Appointment>();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}


<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1>Welcome Back 👋</h1>
        <p>Here's what's coming up for you</p>
    </div>
    <a asp-action="BookAppointment" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Book Appointment
    </a>
</div>


<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card blue">
            <div class="stat-num text-primary">@upcoming.Count</div>
            <div class="stat-lbl">Upcoming Appointments</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card green" style="cursor:pointer;" onclick="location.href='@Url.Action("MyAppointments")'">
            <div class="stat-num" style="color:var(--success);">
                <i class="bi bi-calendar2-check" style="font-size:1.8rem;"></i>
            </div>
            <div class="stat-lbl">My Appointments</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card amber" style="cursor:pointer;" onclick="location.href='@Url.Action("MedicalHistory")'">
            <div class="stat-num" style="color:var(--warning);">
                <i class="bi bi-file-earmark-medical" style="font-size:1.8rem;"></i>
            </div>
            <div class="stat-lbl">Medical History</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card teal" style="cursor:pointer;" onclick="location.href='@Url.Action("MyPrescriptions")'">
            <div class="stat-num" style="color:var(--accent);">
                <i class="bi bi-capsule" style="font-size:1.8rem;"></i>
            </div>
            <div class="stat-lbl">Prescriptions</div>
        </div>
    </div>
</div>


<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-calendar-week me-2"></i>Upcoming Appointments</span>
        <a asp-action="MyAppointments" class="btn btn-sm btn-outline-secondary">
            View All <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
    <div class="card-body p-0">
        @if (!upcoming.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x" style="font-size:2.5rem;color:var(--text-light);"></i>
                <p class="mt-3 mb-2" style="color:var(--text-mid);font-weight:500;">No upcoming appointments</p>
                <a asp-action="BookAppointment" class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Book Your First Appointment
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Doctor</th>
                            <th>Specialization</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in upcoming)
                        {
                            var status = appt.AppointmentStatus.AppointmentStatus1;
                            var bc = status switch {
                                "Requested"  => "bg-secondary",
                                "Confirmed"  => "bg-primary",
                                "CheckedIn"  => "bg-info",
                                "InProgress" => "bg-warning text-dark",
                                "Completed"  => "bg-success",
                                "Cancelled"  => "bg-danger",
                                "Missed"     => "bg-dark",
                                _            => "bg-secondary"
                            };
                            <tr>
                                <td style="font-weight:600;font-size:13px;">@appt.ScheduledDate.ToString("ddd, dd MMM yyyy")</td>
                                <td style="font-size:13px;color:var(--text-mid);">@appt.SlotStartTime.ToString("HH\\:mm") – @appt.SlotEndTime.ToString("HH\\:mm")</td>
                                <td style="font-size:13px;">Dr. @(appt.Doctor?.AspNetUser?.FirstName ?? "—") @(appt.Doctor?.AspNetUser?.LastName ?? "")</td>
                                <td style="font-size:13px;">@(appt.Specialization?.Name ?? "—")</td>
                                <td><span class="badge @bc">@status</span></td>
                                <td>
                                    <a asp-action="AppointmentDetails" asp-route-id="@appt.AppointmentId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
