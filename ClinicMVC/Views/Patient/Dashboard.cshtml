@{
    ViewData["Title"] = "Patient Dashboard";
    var upcoming = ViewBag.UpcomingAppointments as List<ClinicAPI.Models.Appointment>
                   ?? new List<ClinicAPI.Models.Appointment>();
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Welcome Back</h1>
            <p class="text-muted mb-0">Here's what's coming up for you</p>
        </div>
        <a asp-action="BookAppointment" class="btn btn-primary btn-lg">
            <i class="bi bi-plus-circle"></i> Book New Appointment
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card text-bg-primary h-100">
                <div class="card-body">
                    <h6 class="card-title">Upcoming</h6>
                    <h2 class="mb-0">@upcoming.Count</h2>
                    <small>Next appointments</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="card-title text-muted">Quick Links</h6>
                    <a asp-action="MyAppointments" class="d-block">My Appointments</a>
                    <a asp-action="MedicalHistory" class="d-block">Medical History</a>
                    <a asp-action="MyPrescriptions" class="d-block">My Prescriptions</a>
                    <a asp-action="Notifications" class="d-block">Notifications</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 bg-light">
                <div class="card-body">
                    <h6 class="card-title">Need Help?</h6>
                    <p class="mb-1 small">
                        Use the menu above to book an appointment, view your medical history,
                        or check on your prescriptions. If you have any questions, please
                        contact the clinic reception.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Upcoming Appointments</h5>
            <a asp-action="MyAppointments" class="btn btn-sm btn-outline-secondary">View All</a>
        </div>
        <div class="card-body p-0">
            @if (!upcoming.Any())
            {
                <div class="p-4 text-center text-muted">
                    <p class="mb-2">You have no upcoming appointments.</p>
                    <a asp-action="BookAppointment" class="btn btn-sm btn-primary">
                        Book Your First Appointment
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Doctor</th>
                                <th>Specialization</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in upcoming)
                            {
                                <tr>
                                    <td>@appt.ScheduledDate.ToString("ddd, dd MMM yyyy")</td>
                                    <td>@appt.SlotStartTime.ToString("HH:mm") - @appt.SlotEndTime.ToString("HH:mm")</td>
                                    <td>@(appt.Doctor?.AspNetUser?.FirstName ?? "—")</td>
                                    @* ⚠️ Assumed property name: Specialization.SpecializationName *@
                                    <td>@(appt.Specialization?.Name ?? "—")</td>
                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @appt.AppointmentStatus.AppointmentStatus1
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-action="AppointmentDetails"
                                           asp-route-id="@appt.AppointmentId"
                                           class="btn btn-sm btn-outline-primary">Details</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>
