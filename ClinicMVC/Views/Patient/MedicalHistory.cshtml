
@model IEnumerable<ClinicAPI.Models.VisitRecord>
@{
    ViewData["Title"] = "Medical History";
}

<div class="page-header">
    <h1>Medical History</h1>
    <p>All your past clinic visits and their outcomes</p>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-file-earmark-medical" style="font-size:2.5rem;color:var(--text-light);"></i>
                <p class="mt-3 mb-1" style="color:var(--text-mid);font-weight:500;">No visit records yet</p>
                <p style="font-size:13px;color:var(--text-light);">Your history will appear here after your first completed visit.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Visit Date</th>
                            <th>Doctor</th>
                            <th>Specialization</th>
                            <th>Diagnosis</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model)
                        {
                            <tr>
                                <td style="font-weight:600;font-size:13px;">@v.VisitDate.ToString("dd MMM yyyy")</td>
                                <td style="font-size:13px;">Dr. @(v.Doctor?.AspNetUser?.FirstName ?? "—") @(v.Doctor?.AspNetUser?.LastName ?? "")</td>
                                <td style="font-size:13px;">@(v.Appointment?.Specialization?.Name ?? "—")</td>
                                <td style="font-size:13px;color:var(--text-mid);">
                                    @if (string.IsNullOrWhiteSpace(v.Diagnosis)) { <span style="color:var(--text-light);">—</span> }
                                    else { @(v.Diagnosis.Length > 60 ? v.Diagnosis[..60] + "…" : v.Diagnosis) }
                                </td>
                                <td class="text-end">
                                    <a asp-action="VisitRecordDetails" asp-route-id="@v.VisitRecordId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
