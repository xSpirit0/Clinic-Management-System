@model IEnumerable<ClinicAPI.Models.VisitRecord>

@{
    ViewData["Title"] = "Medical History";
}

<div class="container mt-4">

    <h1 class="mb-1">Medical History</h1>
    <p class="text-muted mb-4">All your past clinic visits and their outcomes.</p>

    @if (!Model.Any())
    {
        <div class="card">
            <div class="card-body text-center p-5">
                <h5 class="text-muted">No visit records yet</h5>
                <p class="mb-0">Your medical history will appear here after your first completed appointment.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Visit Date</th>
                                <th>Doctor</th>
                                <th>Specialization</th>
                                <th>Diagnosis</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model)
                            {
                                <tr>
                                    <td>@v.VisitDate.ToString("dd MMM yyyy")</td>
                                    <td>@(v.Doctor?.AspNetUser?.FirstName ?? "—")</td>
                                    @* ⚠️ Assumed property: Specialization.SpecializationName *@
                                    <td>@(v.Appointment?.Specialization?.Name ?? "—")</td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(v.Diagnosis))
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else
                                        {
                                            @(v.Diagnosis.Length > 60
                                                ? v.Diagnosis.Substring(0, 60) + "..."
                                                : v.Diagnosis)
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="VisitRecordDetails" asp-route-id="@v.VisitRecordId"
                                           class="btn btn-sm btn-outline-primary">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="mt-3">
        <a asp-action="Dashboard" class="btn btn-link">← Back to Dashboard</a>
    </div>

</div>
