@model ClinicAPI.Models.Appointment
@{
    ViewData["Title"] = "Cancel Appointment";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1>Cancel Appointment</h1>
        <p>Please confirm you want to cancel this appointment</p>
    </div>
    <a asp-action="MyAppointments" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>
</div>

<div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-2"></i>
    <strong>Are you sure?</strong> Once cancelled, this appointment cannot be restored.
    You will need to book a new one if you change your mind.
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <!-- Appointment being cancelled -->
        <div class="card mb-4">
            <div class="card-header"><i class="bi bi-calendar-x me-2"></i>Appointment You're Cancelling</div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var (lbl, val) in new (string,string)[] {
                        ("Date",           Model.ScheduledDate.ToString("dddd, dd MMMM yyyy")),
                        ("Time",           Model.SlotStartTime.ToString("HH\\:mm") + " – " + Model.SlotEndTime.ToString("HH\\:mm")),
                        ("Doctor",         "Dr. " + (Model.Doctor?.AspNetUser?.FirstName ?? "—") + " " + (Model.Doctor?.AspNetUser?.LastName ?? "")),
                        ("Specialization", Model.Specialization?.Name ?? "—"),
                    })
                    {
                        <div class="col-sm-6">
                            <div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">@lbl</div>
                            <div style="font-weight:500;font-size:14px;">@val</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Reason form -->
        <form asp-action="CancelAppointmentConfirmed" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.AppointmentId" />

            <div class="card">
                <div class="card-body">
                    <div class="mb-4">
                        <label class="form-label">
                            Reason for cancellation
                            <span style="color:var(--text-light);font-weight:400;">(optional)</span>
                        </label>
                        <textarea name="reason" class="form-control" rows="3"
                                  placeholder="e.g. Schedule conflict, feeling better…"></textarea>
                        <div class="form-text">Letting us know helps the clinic improve scheduling.</div>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="MyAppointments" class="btn btn-outline-secondary">
                            Keep Appointment
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-x-circle me-1"></i> Yes, Cancel Appointment
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
