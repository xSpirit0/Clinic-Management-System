@model ClinicAPI.Models.VisitRecord
@{
    ViewData["Title"] = "Visit Record";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1>Visit Record</h1>
        <p>@Model.VisitDate.ToString("dddd, dd MMMM yyyy")</p>
    </div>
    <a asp-action="MedicalHistory" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to History
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <!-- Visit Info -->
        <div class="card mb-4">
            <div class="card-header"><i class="bi bi-person-vcard me-2"></i>Visit Information</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">Visit Date</div>
                        <div style="font-weight:500;">@Model.VisitDate.ToString("dd MMMM yyyy, HH\\:mm")</div>
                    </div>
                    <div class="col-sm-6">
                        <div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">Doctor</div>
                        <div style="font-weight:500;">Dr. @(Model.Doctor?.AspNetUser?.FirstName ?? "—") @(Model.Doctor?.AspNetUser?.LastName ?? "")</div>
                    </div>
                    <div class="col-sm-6">
                        <div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">Specialization</div>
                        <div style="font-weight:500;">@(Model.Appointment?.Specialization?.Name ?? "—")</div>
                    </div>
                    @if (Model.Appointment != null)
                    {
                        <div class="col-sm-6">
                            <div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">Original Appointment</div>
                            <a asp-action="AppointmentDetails" asp-route-id="@Model.Appointment.AppointmentId"
                               style="font-size:14px;">
                                #@Model.Appointment.AppointmentId · @Model.Appointment.ScheduledDate.ToString("dd MMM yyyy")
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Diagnosis & Treatment -->
        <div class="card mb-4">
            <div class="card-header"><i class="bi bi-file-earmark-medical me-2"></i>Diagnosis & Treatment</div>
            <div class="card-body">
                @foreach (var (lbl, val) in new (string,string?)[] {
                    ("Diagnosis",      Model.Diagnosis),
                    ("Treatment",      Model.Treatment),
                    ("Doctor's Notes", Model.DoctorNotes),
                })
                {
                    <div class="mb-4">
                        <div style="font-size:12px;color:var(--text-light);margin-bottom:4px;">@lbl</div>
                        @if (string.IsNullOrWhiteSpace(val))
                        {
                            <em style="color:var(--text-light);font-size:14px;">Not recorded</em>
                        }
                        else
                        {
                            <p style="font-size:14px;margin:0;">@val</p>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Prescriptions -->
        @if (Model.Prescriptions?.Any() == true)
        {
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-capsule me-2"></i>Prescriptions
                    <span class="badge bg-primary ms-2">@Model.Prescriptions.Count</span>
                </div>
                <div class="card-body p-0">
                    @foreach (var pres in Model.Prescriptions)
                    {
                        <div class="d-flex justify-content-between align-items-center px-4 py-3"
                             style="border-bottom:1px solid var(--border);">
                            <div>
                                <div style="font-weight:600;font-size:14px;">Prescription #@pres.PrescriptionId</div>
                                <div style="font-size:12px;color:var(--text-light);">
                                    Issued @pres.IssuedAt.ToString("dd MMM yyyy") · @(pres.PrescriptionItems?.Count ?? 0) medication(s)
                                </div>
                            </div>
                            <a asp-action="PrescriptionDetails" asp-route-id="@pres.PrescriptionId"
                               class="btn btn-sm btn-outline-primary">View Details</a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <div class="card" style="position:sticky;top:80px;">
            <div class="card-header"><i class="bi bi-lightning me-2"></i>Quick Links</div>
            <div class="card-body d-flex flex-column gap-2">
                <a asp-action="MedicalHistory" class="btn btn-outline-primary w-100 text-start">
                    <i class="bi bi-clock-history me-2"></i> Medical History
                </a>
                <a asp-action="MyPrescriptions" class="btn btn-outline-primary w-100 text-start">
                    <i class="bi bi-capsule me-2"></i> My Prescriptions
                </a>
                <a asp-action="Dashboard" class="btn btn-outline-secondary w-100 text-start">
                    <i class="bi bi-house me-2"></i> Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
