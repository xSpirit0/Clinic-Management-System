@model ClinicAPI.Models.VisitRecord

@{
    ViewData["Title"] = "Visit Record";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Visit Record</h1>
        <a asp-action="MedicalHistory" class="btn btn-outline-secondary">← Back to History</a>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Visit Information</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <small class="text-muted d-block">Visit Date</small>
                    <strong>@Model.VisitDate.ToString("dddd, dd MMMM yyyy HH:mm")</strong>
                </div>
                <div class="col-md-6 mb-3">
                    <small class="text-muted d-block">Doctor</small>
                    <strong>@(Model.Doctor?.AspNetUser?.FirstName ?? "—")</strong>
                </div>
                <div class="col-md-6 mb-3">
                    <small class="text-muted d-block">Specialization</small>
                    @* ⚠️ Assumed property: Specialization.Name *@
                    <strong>@(Model.Appointment?.Specialization?.Name ?? "—")</strong>
                </div>
                @if (Model.Appointment != null)
                {
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Original Appointment</small>
                        <a asp-action="AppointmentDetails" asp-route-id="@Model.Appointment.AppointmentId">
                            #@Model.Appointment.AppointmentId on
                            @Model.Appointment.ScheduledDate.ToString("dd MMM yyyy")
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Diagnosis & Treatment</h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <small class="text-muted d-block">Diagnosis</small>
                <p class="mb-0">
                    @if (string.IsNullOrWhiteSpace(Model.Diagnosis))
                    {
                        <em class="text-muted">No diagnosis recorded</em>
                    }
                    else
                    {
                        @Model.Diagnosis
                    }
                </p>
            </div>

            <div class="mb-3">
                <small class="text-muted d-block">Treatment</small>
                <p class="mb-0">
                    @if (string.IsNullOrWhiteSpace(Model.Treatment))
                    {
                        <em class="text-muted">No treatment recorded</em>
                    }
                    else
                    {
                        @Model.Treatment
                    }
                </p>
            </div>

            <div>
                <small class="text-muted d-block">Doctor's Notes</small>
                <p class="mb-0">
                    @if (string.IsNullOrWhiteSpace(Model.DoctorNotes))
                    {
                        <em class="text-muted">No additional notes</em>
                    }
                    else
                    {
                        @Model.DoctorNotes
                    }
                </p>
            </div>
        </div>
    </div>

    @if (Model.Prescriptions != null && Model.Prescriptions.Any())
    {
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Prescriptions</h5>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var pres in Model.Prescriptions)
                {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong>Prescription #@pres.PrescriptionId</strong>
                                <br />
                                <small class="text-muted">
                                    Issued @pres.IssuedAt.ToString("dd MMM yyyy") |
                                    @(pres.PrescriptionItems?.Count ?? 0) medication(s)
                                </small>
                            </div>
                            <a asp-action="PrescriptionDetails" asp-route-id="@pres.PrescriptionId"
                               class="btn btn-sm btn-outline-primary">View Details</a>
                        </div>
                    </li>
                }
            </ul>
        </div>
    }

</div>
