@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div style="font-size:5rem;color:var(--border);margin-bottom:1rem;">
                <i class="bi bi-shield-x"></i>
            </div>
            <h1 style="font-family:var(--font-display);font-size:1.75rem;font-weight:700;color:var(--text-dark);margin-bottom:8px;">
                Access Denied
            </h1>
            <p style="color:var(--text-mid);font-size:15px;margin-bottom:2rem;">
                You don't have permission to access this page.<br>
                Please contact your administrator if you think this is a mistake.
            </p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary" style="padding:10px 28px;">
                <i class="bi bi-house me-2"></i>Back to Home
            </a>
        </div>
    </div>
</div>
