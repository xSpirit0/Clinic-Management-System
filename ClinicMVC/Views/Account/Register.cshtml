@model ClinicMVC.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
   
            <div class="text-center mb-4">
                <div style="width:52px;height:52px;background:var(--primary);border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;">
                    <i class="bi bi-heart-pulse-fill" style="font-size:24px;color:white;"></i>
                </div>
                <h1 style="font-family:var(--font-display);font-size:1.5rem;font-weight:700;color:var(--text-dark);margin-bottom:4px;">
                    Create your account
                </h1>
                <p style="font-size:14px;color:var(--text-mid);">Join Spirit Clinic as a patient</p>
            </div>

            <div class="card">
                <div class="card-body" style="padding:2rem;">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger"></div>
                    }

                    <form asp-action="Register" asp-controller="Account" method="post" autocomplete="off" novalidate>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label">First Name</label>
                                <input asp-for="FirstName" class="form-control" placeholder="First name" />
                                <span asp-validation-for="FirstName" class="text-danger" style="font-size:12px;"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label">Last Name</label>
                                <input asp-for="LastName" class="form-control" placeholder="Last name" />
                                <span asp-validation-for="LastName" class="text-danger" style="font-size:12px;"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email Address</label>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger" style="font-size:12px;"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label">Username</label>
                            <input asp-for="UserName" class="form-control" placeholder="Choose a username" />
                            <span asp-validation-for="UserName" class="text-danger" style="font-size:12px;"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Gender" class="form-label">Gender</label>
                                <select asp-for="Gender" class="form-select">
                                    <option value="">Select gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger" style="font-size:12px;"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
                                <input asp-for="DateOfBirth" class="form-control" type="date" />
                                <span asp-validation-for="DateOfBirth" class="text-danger" style="font-size:12px;"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="CprNumber" class="form-label">CPR Number</label>
                                <input asp-for="CprNumber" class="form-control" placeholder="CPR number" />
                                <span asp-validation-for="CprNumber" class="text-danger" style="font-size:12px;"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="Phone number" />
                                <span asp-validation-for="PhoneNumber" class="text-danger" style="font-size:12px;"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label">Password</label>
                                <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" autocomplete="new-password" />
                                <span asp-validation-for="Password" class="text-danger" style="font-size:12px;"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                                <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="••••••••" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:12px;"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100" style="padding:12px;font-size:15px;">
                            <i class="bi bi-person-plus me-2"></i>Create Account
                        </button>
                    </form>
                </div>
                <div class="card-footer text-center" style="background:var(--surface);padding:1rem;">
                    <span style="font-size:13px;color:var(--text-mid);">Already have an account?</span>
                    <a asp-action="Login" asp-controller="Account" style="font-size:13px;font-weight:600;color:var(--primary);text-decoration:none;margin-left:4px;">
                        Sign in
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
