@model ClinicMVC.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow border-0 rounded-4">
                <!-- Card Header -->
                <div class="card-header text-white text-center rounded-top-4 py-4" style="background: #1b6ec2 !important;">
                    <h1 class="mb-0 h3 fw-bold" style="letter-spacing: 1px;">Login</h1>
                </div>

                <!-- Card Body -->
                <div class="card-body px-4 py-4 bg-white rounded-bottom-4">
                    <form method="post" asp-action="Login" autocomplete="off">
                        <div asp-validation-summary="All" class="text-danger mb-4"></div>
                        <!-- Email Input -->
                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                            <input asp-for="Email" class="form-control form-control-lg rounded-3" placeholder="name@example.com" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Password Input -->
                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-semibold">Password</label>
                            <input asp-for="Password" type="password" class="form-control form-control-lg rounded-3" id="Password" name="Password" placeholder="Password" required />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Remember Me Checkbox -->
                        <div class="form-check mb-4">
                            <input asp-for="RememberMe" class="form-check-input" id="RememberMe" name="RememberMe" />
                            <label asp-for="RememberMe" class="form-check-label" for="RememberMe">Remember Me</label>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid mb-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-semibold shadow-sm">Login</button>
                        </div>
                    </form>
                </div>

                <!-- Card Footer -->
                <div class="card-footer text-center bg-light rounded-bottom-4 py-3 border-0">
                    <small class="text-muted">
                        Don't have an account?
                        <a asp-action="Register" class="text-primary fw-bold text-decoration-none">Register here</a>
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
