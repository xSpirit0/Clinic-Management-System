@model ClinicMVC.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">

            <!-- Brand -->
            <div class="text-center mb-4">
                <div style="width:52px;height:52px;background:var(--primary);border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;">
                    <i class="bi bi-heart-pulse-fill" style="font-size:24px;color:white;"></i>
                </div>
                <h1 style="font-family:var(--font-display);font-size:1.5rem;font-weight:700;color:var(--text-dark);margin-bottom:4px;">
                    Welcome back
                </h1>
                <p style="font-size:14px;color:var(--text-mid);">Sign in to Spirit Clinic</p>
            </div>

            <!-- Card -->
            <div class="card">
                <div class="card-body" style="padding:2rem;">

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger"></div>
                    }

                    <form method="post" asp-action="Login" autocomplete="off">
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email address</label>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger" style="font-size:12px;"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger" style="font-size:12px;"></span>
                        </div>
                        <div class="form-check mb-4">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label" style="font-size:13px;color:var(--text-mid);">
                                Remember me
                            </label>
                        </div>
                        <button type="submit" class="btn btn-primary w-100" style="padding:12px;font-size:15px;">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                        </button>
                    </form>
                </div>
                <div class="card-footer text-center" style="background:var(--surface);padding:1rem;">
                    <span style="font-size:13px;color:var(--text-mid);">Don't have an account?</span>
                    <a asp-action="Register" style="font-size:13px;font-weight:600;color:var(--primary);text-decoration:none;margin-left:4px;">
                        Register here
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
