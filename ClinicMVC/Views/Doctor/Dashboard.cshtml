@{
    ViewData["Title"] = "Doctor Dashboard";
    var today     = ViewBag.TodayAppointments as List<ClinicAPI.Models.Appointment> ?? new List<ClinicAPI.Models.Appointment>();
    var upcoming  = ViewBag.UpcomingWeek      as List<ClinicAPI.Models.Appointment> ?? new List<ClinicAPI.Models.Appointment>();
    int totalToday     = ViewBag.TotalToday     ?? 0;
    int completedToday = ViewBag.CompletedToday ?? 0;
    int inProgressNow  = ViewBag.InProgressNow  ?? 0;
    int pendingToday   = ViewBag.PendingToday   ?? 0;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1>Doctor Dashboard</h1>
        <p>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="MySchedule" class="btn btn-outline-secondary">
            <i class="bi bi-calendar3 me-1"></i> My Schedule
        </a>
        <a asp-action="MyPatients" class="btn btn-outline-primary">
            <i class="bi bi-people me-1"></i> My Patients
        </a>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card blue">
            <div class="stat-num text-primary">@totalToday</div>
            <div class="stat-lbl">Today's Total</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card amber">
            <div class="stat-num" style="color:var(--warning)">@pendingToday</div>
            <div class="stat-lbl">Pending</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card teal">
            <div class="stat-num" style="color:var(--accent)">@inProgressNow</div>
            <div class="stat-lbl">In Progress</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card green">
            <div class="stat-num" style="color:var(--success)">@completedToday</div>
            <div class="stat-lbl">Completed Today</div>
        </div>
    </div>
</div>

<!-- Today's Appointments -->
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-calendar-day me-2"></i>Today's Appointments</span>
        <a asp-action="MyAppointments" asp-route-filter="today" class="btn btn-sm btn-outline-secondary">
            View All <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
    <div class="card-body p-0">
        @if (!today.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x" style="font-size:2.5rem;color:var(--text-light);"></i>
                <p class="mt-3" style="color:var(--text-mid);">No appointments scheduled for today.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Patient</th>
                            <th>Specialization</th>
                            <th>Complaint</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in today)
                        {
                            var s = a.AppointmentStatus.AppointmentStatus1;
                            var bc = s switch {
                                "Requested"  => "bg-secondary",
                                "Confirmed"  => "bg-primary",
                                "CheckedIn"  => "bg-info",
                                "InProgress" => "bg-warning text-dark",
                                "Completed"  => "bg-success",
                                "Cancelled"  => "bg-danger",
                                "Missed"     => "bg-dark",
                                _            => "bg-secondary"
                            };
                            <tr>
                                <td style="font-family:var(--font-display);font-weight:600;">@a.SlotStartTime.ToString("HH\\:mm")</td>
                                <td style="font-size:13px;">@(a.Patient?.AspNetUser?.FirstName ?? "—") @(a.Patient?.AspNetUser?.LastName ?? "")</td>
                                <td style="font-size:13px;">@(a.Specialization?.Name ?? "—")</td>
                                <td style="font-size:13px;color:var(--text-mid);">
                                    @if (string.IsNullOrWhiteSpace(a.ComplaintReason)) { <span>—</span> }
                                    else { @(a.ComplaintReason.Length > 40 ? a.ComplaintReason[..40] + "…" : a.ComplaintReason) }
                                </td>
                                <td><span class="badge @bc">@s</span></td>
                                <td class="text-end">
                                    <a asp-action="AppointmentDetails" asp-route-id="@a.AppointmentId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Upcoming This Week -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-calendar-week me-2"></i>Upcoming This Week</span>
        <a asp-action="MyAppointments" asp-route-filter="upcoming" class="btn btn-sm btn-outline-secondary">
            View All <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
    <div class="card-body p-0">
        @if (!upcoming.Any())
        {
            <div class="text-center py-4">
                <p style="color:var(--text-light);font-size:14px;">No upcoming appointments in the next 7 days.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Patient</th>
                            <th>Specialization</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in upcoming)
                        {
                            <tr>
                                <td style="font-weight:600;font-size:13px;">@a.ScheduledDate.ToString("ddd, dd MMM")</td>
                                <td style="font-size:13px;color:var(--text-mid);">@a.SlotStartTime.ToString("HH\\:mm")</td>
                                <td style="font-size:13px;">@(a.Patient?.AspNetUser?.FirstName ?? "—") @(a.Patient?.AspNetUser?.LastName ?? "")</td>
                                <td style="font-size:13px;">@(a.Specialization?.Name ?? "—")</td>
                                <td><span class="badge bg-primary">@a.AppointmentStatus.AppointmentStatus1</span></td>
                                <td class="text-end">
                                    <a asp-action="AppointmentDetails" asp-route-id="@a.AppointmentId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
