@{
    ViewData["Title"] = "Doctor Dashboard";
    var today = ViewBag.TodayAppointments as List<ClinicAPI.Models.Appointment>
                ?? new List<ClinicAPI.Models.Appointment>();
    var upcoming = ViewBag.UpcomingWeek as List<ClinicAPI.Models.Appointment>
                   ?? new List<ClinicAPI.Models.Appointment>();
    int totalToday    = ViewBag.TotalToday    ?? 0;
    int completedToday= ViewBag.CompletedToday?? 0;
    int inProgressNow = ViewBag.InProgressNow ?? 0;
    int pendingToday  = ViewBag.PendingToday  ?? 0;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Doctor Dashboard</h1>
            <p class="text-muted mb-0">@DateTime.Today.ToString("dddd, dd MMMM yyyy")</p>
        </div>
        <div>
            <a asp-action="MySchedule" class="btn btn-outline-secondary">My Schedule</a>
            <a asp-action="MyPatients" class="btn btn-outline-secondary">My Patients</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card text-bg-primary h-100">
                <div class="card-body">
                    <h6 class="card-title">Today</h6>
                    <h2 class="mb-0">@totalToday</h2>
                    <small>Total appointments</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-warning h-100">
                <div class="card-body">
                    <h6 class="card-title">Pending</h6>
                    <h2 class="mb-0">@pendingToday</h2>
                    <small>Not yet seen</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-info h-100">
                <div class="card-body">
                    <h6 class="card-title">In Progress</h6>
                    <h2 class="mb-0">@inProgressNow</h2>
                    <small>Currently with you</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-success h-100">
                <div class="card-body">
                    <h6 class="card-title">Completed</h6>
                    <h2 class="mb-0">@completedToday</h2>
                    <small>Done today</small>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Today's Appointments</h5>
            <a asp-action="MyAppointments" asp-route-filter="today"
               class="btn btn-sm btn-outline-secondary">View All</a>
        </div>
        <div class="card-body p-0">
            @if (!today.Any())
            {
                <div class="p-4 text-center text-muted">
                    <p class="mb-0">No appointments scheduled for today.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Time</th>
                                <th>Patient</th>
                                <th>Specialization</th>
                                <th>Reason</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in today)
                            {
                                var status = a.AppointmentStatus.AppointmentStatus1;
                                var badgeClass = status switch
                                {
                                    "Requested"  => "bg-warning text-dark",
                                    "Confirmed"  => "bg-info text-dark",
                                    "CheckedIn"  => "bg-primary",
                                    "InProgress" => "bg-primary",
                                    "Completed"  => "bg-success",
                                    "Cancelled"  => "bg-danger",
                                    "Missed"     => "bg-secondary",
                                    _ => "bg-light text-dark"
                                };
                                <tr>
                                    <td><strong>@a.SlotStartTime.ToString("HH:mm")</strong></td>
                                    <td>@(a.Patient?.AspNetUser?.FirstName ?? "—") @(a.Patient?.AspNetUser?.LastName ?? "")</td>
                                    <td>@(a.Specialization?.Name ?? "—")</td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(a.ComplaintReason))
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else
                                        {
                                            @(a.ComplaintReason.Length > 40
                                                ? a.ComplaintReason.Substring(0, 40) + "..."
                                                : a.ComplaintReason)
                                        }
                                    </td>
                                    <td><span class="badge @badgeClass">@status</span></td>
                                    <td class="text-end">
                                        <a asp-action="AppointmentDetails"
                                           asp-route-id="@a.AppointmentId"
                                           class="btn btn-sm btn-outline-primary">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Upcoming This Week</h5>
            <a asp-action="MyAppointments" asp-route-filter="upcoming"
               class="btn btn-sm btn-outline-secondary">View All</a>
        </div>
        <div class="card-body p-0">
            @if (!upcoming.Any())
            {
                <div class="p-4 text-center text-muted">
                    <p class="mb-0">No upcoming appointments in the next 7 days.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Patient</th>
                                <th>Specialization</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in upcoming)
                            {
                                <tr>
                                    <td>@a.ScheduledDate.ToString("ddd, dd MMM")</td>
                                    <td>@a.SlotStartTime.ToString("HH:mm")</td>
                                    <td>@(a.Patient?.AspNetUser?.FirstName ?? "—") @(a.Patient?.AspNetUser?.LastName ?? "")</td>
                                    <td>@(a.Specialization?.Name ?? "—")</td>
                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @a.AppointmentStatus.AppointmentStatus1
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="AppointmentDetails"
                                           asp-route-id="@a.AppointmentId"
                                           class="btn btn-sm btn-outline-primary">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>
