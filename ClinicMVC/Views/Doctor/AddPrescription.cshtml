@model ClinicAPI.Models.VisitRecord
@{
    ViewData["Title"] = "Add Prescription";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1>Add Prescription</h1>
        <p>
            For @(Model.Appointment?.Patient?.AspNetUser?.FirstName ?? "patient") @(Model.Appointment?.Patient?.AspNetUser?.LastName ?? "")
            · Visit on @Model.VisitDate.ToString("dd MMM yyyy")
        </p>
    </div>
    <a asp-action="AppointmentDetails" asp-route-id="@Model.AppointmentId"
       class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>
</div>

<!-- Existing prescriptions notice -->
@if (Model.Prescriptions?.Any() == true)
{
    <div class="alert alert-info mb-4" style="font-size:13px;">
        <i class="bi bi-info-circle me-2"></i>
        <strong>Existing prescriptions for this visit:</strong>
        @foreach (var p in Model.Prescriptions)
        {
            <div class="mt-1">
                <strong>#@p.PrescriptionId</strong> —
                @(p.PrescriptionItems?.Count ?? 0) medication(s) — issued @p.IssuedAt.ToString("dd MMM yyyy")
                @if (p.PrescriptionItems?.Any() == true)
                {
                    <span style="color:var(--text-mid);"> (@string.Join(", ", p.PrescriptionItems.Select(i => i.MedicationName)))</span>
                }
            </div>
        }
        <div class="mt-2" style="color:var(--text-mid);">
            Adding medications below will create a <strong>new</strong> prescription.
        </div>
    </div>
}

<form asp-action="AddPrescription" method="post" id="prescriptionForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="visitRecordId" value="@Model.VisitRecordId" />

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-capsule me-2"></i>Medications</span>
            <button type="button" class="btn btn-sm btn-success" onclick="addMedicationRow()">
                <i class="bi bi-plus-circle me-1"></i> Add Another
            </button>
        </div>
        <div class="card-body" id="medicationsContainer">

            <div class="medication-row p-3 mb-3"
                 style="border:1.5px solid var(--border);border-radius:var(--radius);background:var(--surface);">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span style="font-family:var(--font-display);font-weight:600;font-size:14px;">Medication 1</span>
                    <button type="button" class="btn btn-sm btn-outline-danger"
                            onclick="removeMedicationRow(this)" style="display:none;">
                        <i class="bi bi-trash me-1"></i> Remove
                    </button>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Medication Name *</label>
                        <input type="text" name="medicationName" class="form-control" required
                               placeholder="e.g. Paracetamol" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Dosage *</label>
                        <input type="text" name="dosage" class="form-control" required
                               placeholder="e.g. 500mg" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Duration (days)</label>
                        <input type="number" name="durationDays" class="form-control" min="1"
                               placeholder="e.g. 7" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Frequency *</label>
                        <input type="text" name="frequency" class="form-control" required
                               placeholder="e.g. Every 8 hours" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Instructions</label>
                        <input type="text" name="instructions" class="form-control"
                               placeholder="e.g. Take with food" />
                    </div>
                </div>
            </div>

        </div>
        <div class="card-footer d-flex justify-content-end gap-2">
            <a asp-action="AppointmentDetails" asp-route-id="@Model.AppointmentId"
               class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle me-1"></i> Save Prescription
            </button>
        </div>
    </div>
</form>

@section Scripts {
<script>
let medicationCount = 1;

function addMedicationRow() {
    medicationCount++;
    const container = document.getElementById('medicationsContainer');
    const row = document.createElement('div');
    row.className = 'medication-row p-3 mb-3';
    row.style.cssText = 'border:1.5px solid var(--border);border-radius:var(--radius);background:var(--surface);';
    row.innerHTML = `
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span style="font-family:var(--font-display);font-weight:600;font-size:14px;">Medication ${medicationCount}</span>
            <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeMedicationRow(this)">
                <i class="bi bi-trash me-1"></i> Remove
            </button>
        </div>
        <div class="row g-3">
            <div class="col-md-6"><label class="form-label">Medication Name *</label>
                <input type="text" name="medicationName" class="form-control" required placeholder="e.g. Paracetamol" /></div>
            <div class="col-md-3"><label class="form-label">Dosage *</label>
                <input type="text" name="dosage" class="form-control" required placeholder="e.g. 500mg" /></div>
            <div class="col-md-3"><label class="form-label">Duration (days)</label>
                <input type="number" name="durationDays" class="form-control" min="1" placeholder="e.g. 7" /></div>
            <div class="col-md-6"><label class="form-label">Frequency *</label>
                <input type="text" name="frequency" class="form-control" required placeholder="e.g. Every 8 hours" /></div>
            <div class="col-md-6"><label class="form-label">Instructions</label>
                <input type="text" name="instructions" class="form-control" placeholder="e.g. Take with food" /></div>
        </div>`;
    container.appendChild(row);
    updateRowNumbering();
}

function removeMedicationRow(btn) {
    const rows = document.querySelectorAll('.medication-row');
    if (rows.length <= 1) { alert('At least one medication is required.'); return; }
    btn.closest('.medication-row').remove();
    updateRowNumbering();
}

function updateRowNumbering() {
    const rows = document.querySelectorAll('.medication-row');
    rows.forEach((row, i) => {
        row.querySelector('span').textContent = `Medication ${i + 1}`;
        const btn = row.querySelector('.btn-outline-danger');
        if (btn) btn.style.display = rows.length > 1 ? 'inline-flex' : 'none';
    });
    medicationCount = rows.length;
}

document.getElementById('prescriptionForm').addEventListener('submit', function(e) {
    const meds = document.querySelectorAll('input[name="medicationName"]');
    if (!Array.from(meds).some(m => m.value.trim())) {
        e.preventDefault();
        alert('Please add at least one medication.');
    }
});
</script>
}
