@model IEnumerable<ClinicAPI.Models.DoctorSchedule>
@{
    ViewData["Title"] = "My Schedule";
    var leaves = ViewBag.Leaves as List<ClinicAPI.Models.DoctorLeave> ?? new List<ClinicAPI.Models.DoctorLeave>();
    string DayName(int d) => d switch { 0 => "Sunday", 1 => "Monday", 2 => "Tuesday", 3 => "Wednesday", 4 => "Thursday", 5 => "Friday", 6 => "Saturday", _ => $"Day {d}" };
}

<div class="page-header">
    <h1>My Schedule</h1>
    <p>Your weekly working hours and leave requests</p>
    <a asp-action="SubmitLeave" class="btn btn-primary">
        <i class="bi bi-calendar-plus me-1"></i>Request Leave
    </a>
</div>

<div class="card mb-4">
    <div class="card-header"><i class="bi bi-calendar3 me-2"></i>Weekly Working Hours</div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x" style="font-size:2.5rem;color:var(--text-light);"></i>
                <p class="mt-3" style="color:var(--text-mid);">No working hours set yet. Contact the Clinic Manager.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th style="width:25%">Day</th>
                            <th>Working Hours</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int day = 0; day < 7; day++)
                        {
                            var schedules = Model.Where(s => s.DayOfWeek == day).ToList();
                            <tr>
                                <td style="font-weight:600;font-size:14px;">@DayName(day)</td>
                                @if (!schedules.Any())
                                {
                                    <td colspan="2" style="color:var(--text-light);font-size:13px;font-style:italic;">Day off</td>
                                }
                                else
                                {
                                    <td style="font-size:13px;">
                                        @foreach (var s in schedules)
                                        {
                                            <div style="font-weight:500;">
                                                @s.StartTime.ToString("HH\\:mm") – @s.EndTime.ToString("HH\\:mm")
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @foreach (var s in schedules)
                                        {
                                            <span class="badge @(s.IsActive ? "bg-success" : "bg-secondary")">
                                                @(s.IsActive ? "Active" : "Inactive")
                                            </span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-calendar-minus me-2"></i>My Leave Requests</span>
        <a asp-action="SubmitLeave" class="btn btn-sm btn-primary">
            <i class="bi bi-plus me-1"></i>New Request
        </a>
    </div>
    <div class="card-body p-0">
        @if (!leaves.Any())
        {
            <div class="text-center py-4">
                <p style="color:var(--text-light);font-size:14px;">No leave requests yet.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr><th>From</th><th>To</th><th>Days</th><th>Reason</th><th>Status</th><th>Notes</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var l in leaves)
                        {
                            var days = l.EndDate.DayNumber - l.StartDate.DayNumber + 1;
                            var statusName = l.LeaveStatus?.LeaveStatus1 ?? "Pending";
                            var badgeClass = statusName switch
                            {
                                "Approved" => "bg-success",
                                "Rejected" => "bg-danger",
                                _ => "bg-warning text-dark"
                            };
                            <tr>
                                <td style="font-weight:600;font-size:13px;">@l.StartDate.ToString("ddd, dd MMM yyyy")</td>
                                <td style="font-size:13px;">@l.EndDate.ToString("ddd, dd MMM yyyy")</td>
                                <td><span class="badge bg-primary">@days</span></td>
                                <td style="font-size:13px;color:var(--text-mid);">@(l.Reason ?? "—")</td>
                                <td><span class="badge @badgeClass">@statusName</span></td>
                                <td style="font-size:13px;color:var(--text-mid);">
                                    @if (statusName == "Rejected" && !string.IsNullOrWhiteSpace(l.RejectionReason))
                                    {
                                        <span style="color:#dc3545;">@l.RejectionReason</span>
                                    }
                                    else if (statusName == "Approved" && l.ApprovedAt.HasValue)
                                    {
                                        <span>Approved @l.ApprovedAt.Value.ToString("dd MMM yyyy")</span>
                                    }
                                    else
                                    {

                                        <span>—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
