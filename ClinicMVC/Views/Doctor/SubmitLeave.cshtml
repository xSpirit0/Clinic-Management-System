@{
    ViewData["Title"] = "Request Leave";
    var today = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
}

<div class="page-header">
    <h1>Request Leave</h1>
    <p>Submit a leave request for the clinic manager to review</p>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header"><i class="bi bi-calendar-plus me-2"></i>Leave Request Details</div>
            <div class="card-body">

                <form asp-action="SubmitLeave" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewContext.ModelState.IsValid ? "none" : "block")"></div>

                    <div class="mb-3">
                        <label class="form-label" style="font-weight:600;font-size:14px;">Start Date <span style="color:#dc3545;">*</span></label>
                        <input type="date" name="startDate" id="startDate" class="form-control"
                               min="@today" required />
                        <span class="text-danger" style="font-size:12px;" id="startDateError"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="font-weight:600;font-size:14px;">End Date <span style="color:#dc3545;">*</span></label>
                        <input type="date" name="endDate" id="endDate" class="form-control"
                               min="@today" required />
                        <span class="text-danger" style="font-size:12px;" id="endDateError"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label" style="font-weight:600;font-size:14px;">Reason <span style="color:var(--text-light);font-weight:400;">(optional)</span></label>
                        <textarea name="reason" class="form-control" rows="3"
                                  placeholder="E.g. Medical leave, personal matter…"
                                  maxlength="500"></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send me-1"></i>Submit Request
                        </button>
                        <a asp-action="MySchedule" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>

            </div>
        </div>

        <div class="alert alert-info mt-3" style="font-size:13px;">
            <i class="bi bi-info-circle me-2"></i>
            Your request will be sent to the Clinic Manager for review. You will be notified once a decision is made.
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('startDate').addEventListener('change', function () {
            var startVal = this.value;
            var endInput = document.getElementById('endDate');
            endInput.min = startVal;
            if (endInput.value && endInput.value < startVal) {
                endInput.value = startVal;
            }
        });
    </script>
}
