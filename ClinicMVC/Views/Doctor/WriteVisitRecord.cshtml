@model ClinicAPI.Models.Appointment
@{
    ViewData["Title"] = "Write Visit Record";
    var existing  = Model.VisitRecord;
    var isEditing = existing != null;
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1>@(isEditing ? "Edit" : "Write") Visit Record</h1>
        <p>
            For @(Model.Patient?.AspNetUser?.FirstName ?? "patient") @(Model.Patient?.AspNetUser?.LastName ?? "")
            · @Model.ScheduledDate.ToString("dd MMM yyyy")
        </p>
    </div>
    <a asp-action="AppointmentDetails" asp-route-id="@Model.AppointmentId"
       class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
       
        <div class="card mb-4" style="background:var(--surface);">
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var (lbl, val) in new (string,string)[] {
                        ("Patient",        (Model.Patient?.AspNetUser?.FirstName ?? "—") + " " + (Model.Patient?.AspNetUser?.LastName ?? "")),
                        ("CPR",            Model.Patient?.Cprnumber ?? "—"),
                        ("Specialization", Model.Specialization?.Name ?? "—"),
                        ("Slot",           Model.SlotStartTime.ToString("HH\\:mm") + " – " + Model.SlotEndTime.ToString("HH\\:mm")),
                    })
                    {
                        <div class="col-sm-6 col-md-3">
                            <div style="font-size:11px;color:var(--text-light);margin-bottom:2px;">@lbl</div>
                            <div style="font-weight:600;font-size:13px;">@val</div>
                        </div>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.ComplaintReason))
                {
                    <hr style="border-color:var(--border);margin:12px 0;" />
                    <div style="font-size:11px;color:var(--text-light);margin-bottom:4px;">Patient's Complaint</div>
                    <p style="font-size:13px;margin:0;">@Model.ComplaintReason</p>
                }
            </div>
        </div>

        @if (isEditing)
        {
            <div class="alert alert-info mb-4" style="font-size:13px;">
                <i class="bi bi-pencil me-2"></i>
                Editing existing visit record from @existing!.VisitDate.ToString("dd MMM yyyy, HH\\:mm").
            </div>
        }
        else
        {
            <div class="alert alert-success mb-4" style="font-size:13px;">
                <i class="bi bi-check-circle me-2"></i>
                <strong>Saving will mark this appointment as Completed.</strong> You can add prescriptions afterwards.
            </div>
        }

        <form asp-action="WriteVisitRecord" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />

            <div class="card">
                <div class="card-body">
                    <div class="mb-4">
                        <label class="form-label">Diagnosis</label>
                        <textarea name="diagnosis" class="form-control" rows="3"
                                  placeholder="e.g. Acute viral upper respiratory infection">@(existing?.Diagnosis)</textarea>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Treatment Plan</label>
                        <textarea name="treatment" class="form-control" rows="3"
                                  placeholder="e.g. Rest, fluids, paracetamol for fever. Return if symptoms worsen.">@(existing?.Treatment)</textarea>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">
                            Doctor's Notes
                            <span style="color:var(--text-light);font-weight:400;font-size:12px;">(optional, internal use)</span>
                        </label>
                        <textarea name="doctorNotes" class="form-control" rows="4"
                                  placeholder="Vitals, examination findings, observations…">@(existing?.DoctorNotes)</textarea>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-end gap-2">
                    <a asp-action="AppointmentDetails" asp-route-id="@Model.AppointmentId"
                       class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i>
                        @(isEditing ? "Update Record" : "Save & Complete Visit")
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div class="col-lg-4">
        <div class="card" style="position:sticky;top:80px;">
            <div class="card-header"><i class="bi bi-lightbulb me-2"></i>Tips</div>
            <div class="card-body" style="font-size:13px;color:var(--text-mid);">
                <p><strong>Diagnosis</strong> — Be specific. Include ICD-10 codes where applicable.</p>
                <p><strong>Treatment</strong> — Include medication, rest, follow-up instructions.</p>
                <p class="mb-0"><strong>Notes</strong> — Internal use only. Record vitals, observations, and exam findings here.</p>
            </div>
        </div>
    </div>
</div>
