@model IEnumerable<ClinicAPI.Models.Appointment>
@{
    ViewData["Title"] = "My Appointments";
    string currentFilter = ViewBag.CurrentFilter ?? "today";
    string currentStatus = ViewBag.CurrentStatus ?? "all";
    var allStatuses = ViewBag.AllStatuses as List<string> ?? new List<string>();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1>My Appointments</h1>
        <p>@Model.Count() appointment(s) found</p>
    </div>
</div>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="MyAppointments" class="row g-3 align-items-end">
            <div class="col-12">
                <label class="form-label">Date Range</label>
                <div class="d-flex gap-2 flex-wrap">
                    @foreach (var (label, val) in new[] { ("Today","today"),("Upcoming","upcoming"),("Past","past"),("All","all") })
                    {
                        <a asp-action="MyAppointments" asp-route-filter="@val" asp-route-status="@currentStatus"
                           class="btn btn-sm @(currentFilter == val ? "btn-primary" : "btn-outline-secondary")">
                            @label
                        </a>
                    }
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Status</label>
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="all" selected="@(currentStatus == "all")">All Statuses</option>
                    @foreach (var s in allStatuses)
                    {
                        <option value="@s" selected="@(currentStatus == s)">@s</option>
                    }
                </select>
            </div>
            <input type="hidden" name="filter" value="@currentFilter" />
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x" style="font-size:2.5rem;color:var(--text-light);"></i>
                <p class="mt-3" style="color:var(--text-mid);">No appointments match these filters.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Patient</th>
                            <th>Specialization</th>
                            <th>Complaint</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            var s = a.AppointmentStatus.AppointmentStatus1;
                            var bc = s switch {
                                "Requested"  => "bg-secondary",
                                "Confirmed"  => "bg-primary",
                                "CheckedIn"  => "bg-info",
                                "InProgress" => "bg-warning text-dark",
                                "Completed"  => "bg-success",
                                "Cancelled"  => "bg-danger",
                                "Missed"     => "bg-dark",
                                _            => "bg-secondary"
                            };
                            <tr>
                                <td style="font-weight:600;font-size:13px;">@a.ScheduledDate.ToString("ddd, dd MMM yyyy")</td>
                                <td style="font-size:13px;color:var(--text-mid);">@a.SlotStartTime.ToString("HH\\:mm") – @a.SlotEndTime.ToString("HH\\:mm")</td>
                                <td style="font-size:13px;">@(a.Patient?.AspNetUser?.FirstName ?? "—") @(a.Patient?.AspNetUser?.LastName ?? "")</td>
                                <td style="font-size:13px;">@(a.Specialization?.Name ?? "—")</td>
                                <td style="font-size:13px;color:var(--text-mid);">
                                    @if (string.IsNullOrWhiteSpace(a.ComplaintReason)) { <span>—</span> }
                                    else { @(a.ComplaintReason.Length > 40 ? a.ComplaintReason[..40] + "…" : a.ComplaintReason) }
                                </td>
                                <td><span class="badge @bc">@s</span></td>
                                <td class="text-end">
                                    <a asp-action="AppointmentDetails" asp-route-id="@a.AppointmentId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i> Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
