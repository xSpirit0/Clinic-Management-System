@model IEnumerable<ClinicAPI.Models.PatientProfile>

@{
    ViewData["Title"] = "My Patients";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="mb-1">My Patients</h1>
            <p class="text-muted mb-0">Patients you've seen at least once.</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-link">← Dashboard</a>
    </div>

    @if (!Model.Any())
    {
        <div class="card">
            <div class="card-body text-center p-5">
                <h5 class="text-muted">No patients yet</h5>
                <p class="mb-0">Patients you see will appear here automatically.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-body py-2">
                <small class="text-muted">@Model.Count() unique patient(s)</small>
            </div>
        </div>

        <div class="row g-3">
            @foreach (var p in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title mb-1">
                                @(p.AspNetUser?.FirstName ?? "Unknown")
                            </h5>
                            <small class="text-muted d-block mb-2">
                                CPR: @p.Cprnumber
                            </small>

                            <div class="small mb-3">
                                <div>
                                    <span class="text-muted">DOB:</span>
                                    @p.DateOfBirth.ToString("dd MMM yyyy")
                                </div>
                                @if (!string.IsNullOrWhiteSpace(p.Gender))
                                {
                                    <div>
                                        <span class="text-muted">Gender:</span> @p.Gender
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(p.BloodType))
                                {
                                    <div>
                                        <span class="text-muted">Blood:</span> @p.BloodType
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-transparent">
                            <a asp-action="PatientHistory" asp-route-id="@p.PatientId"
                               class="btn btn-sm btn-primary w-100">
                                View Full History
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
