@* ===== MyPatients.cshtml ===== *@
@model IEnumerable<ClinicAPI.Models.PatientProfile>
@{
    ViewData["Title"] = "My Patients";
}

<div class="page-header">
    <h1>My Patients</h1>
    <p>Patients you've seen at least once — @Model.Count() total</p>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="text-center py-5">
            <i class="bi bi-people" style="font-size:2.5rem;color:var(--text-light);"></i>
            <p class="mt-3 mb-1" style="color:var(--text-mid);font-weight:500;">No patients yet</p>
            <p style="font-size:13px;color:var(--text-light);">Patients you see will appear here automatically.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var p in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div style="width:44px;height:44px;background:var(--primary-light);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-weight:700;color:var(--primary);font-size:18px;flex-shrink:0;">
                                @(p.AspNetUser?.FirstName?.Length > 0 ? p.AspNetUser.FirstName[0].ToString().ToUpper() : "P")
                            </div>
                            <div>
                                <div style="font-weight:700;font-size:15px;">@(p.AspNetUser?.FirstName ?? "Unknown") @(p.AspNetUser?.LastName ?? "")</div>
                                <div style="font-size:12px;color:var(--text-light);">CPR: @p.Cprnumber</div>
                            </div>
                        </div>
                        <div style="font-size:13px;color:var(--text-mid);" class="mb-1">
                            <i class="bi bi-calendar me-1"></i> DOB: @p.DateOfBirth.ToString("dd MMM yyyy")
                        </div>
                        @if (!string.IsNullOrWhiteSpace(p.Gender))
                        {
                            <div style="font-size:13px;color:var(--text-mid);" class="mb-1">
                                <i class="bi bi-person me-1"></i> @p.Gender
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(p.BloodType))
                        {
                            <span class="badge bg-danger mt-1">@p.BloodType</span>
                        }
                    </div>
                    <div class="card-footer">
                        <a asp-action="PatientHistory" asp-route-id="@p.PatientId"
                           class="btn btn-primary w-100 btn-sm">
                            <i class="bi bi-clock-history me-1"></i> View Full History
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
