@model IEnumerable<ClinicAPI.Models.Appointment>
@{
    ViewData["Title"] = "Patient History";
    var patient           = ViewBag.Patient as ClinicAPI.Models.PatientProfile;
    var totalAppts        = Model.Count();
    var completedCount    = Model.Count(a => a.AppointmentStatus.AppointmentStatus1 == "Completed");
    var totalVisits       = Model.Count(a => a.VisitRecord != null);
    var totalPrescriptions= Model.Where(a => a.VisitRecord?.Prescriptions != null).Sum(a => a.VisitRecord!.Prescriptions.Count);
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1>@(patient?.AspNetUser?.FirstName ?? "Patient") @(patient?.AspNetUser?.LastName ?? "")</h1>
        <p>Full medical history</p>
    </div>
    <a asp-action="MyPatients" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> My Patients
    </a>
</div>

<div class="row g-4 mb-4">
    <!-- Patient info -->
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-person-vcard me-2"></i>Patient Profile</div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var (lbl, val) in new (string, string)[] {
                        ("CPR Number",      patient?.Cprnumber ?? "—"),
                        ("Reference",       patient?.PatientReferenceNumber ?? "—"),
                        ("Date of Birth",   patient?.DateOfBirth.ToString("dd MMM yyyy") ?? "—"),
                        ("Gender",          patient?.Gender ?? "—"),
                        ("Blood Type",      patient?.BloodType ?? "—"),
                        ("Emergency",       string.IsNullOrWhiteSpace(patient?.EmergencyContactName) ? "—" : patient!.EmergencyContactName + (string.IsNullOrWhiteSpace(patient.EmergencyContactPhone) ? "" : $" ({patient.EmergencyContactPhone})")),
                    })
                    {
                        <div class="col-sm-6">
                            <div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">@lbl</div>
                            <div style="font-weight:500;font-size:14px;">@val</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Quick stats -->
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-bar-chart me-2"></i>Quick Stats</div>
            <div class="card-body">
                @foreach (var (lbl, val) in new (string, int)[] {
                    ("Total Appointments", totalAppts),
                    ("Completed Visits",   completedCount),
                    ("Visit Records",      totalVisits),
                    ("Prescriptions",      totalPrescriptions),
                })
                {
                    <div class="d-flex justify-content-between py-2"
                         style="border-bottom:1px solid var(--border);font-size:14px;">
                        <span style="color:var(--text-mid);">@lbl</span>
                        <span style="font-weight:700;color:var(--primary);">@val</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Appointment History Accordion -->
<div class="page-header" style="margin-bottom:1rem;">
    <h1 style="font-size:1.2rem;">Appointment History</h1>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="text-center py-5">
            <i class="bi bi-calendar-x" style="font-size:2.5rem;color:var(--text-light);"></i>
            <p class="mt-3" style="color:var(--text-mid);">No appointment history.</p>
        </div>
    </div>
}
else
{
    <div class="accordion" id="historyAccordion">
        @{ int idx = 0; }
        @foreach (var a in Model)
        {
            idx++;
            var s = a.AppointmentStatus.AppointmentStatus1;
            var bc = s switch {
                "Requested"  => "bg-secondary",
                "Confirmed"  => "bg-primary",
                "CheckedIn"  => "bg-info",
                "InProgress" => "bg-warning text-dark",
                "Completed"  => "bg-success",
                "Cancelled"  => "bg-danger",
                "Missed"     => "bg-dark",
                _            => "bg-secondary"
            };
            var collapseId  = $"history-{idx}";
            var hasVisitRec = a.VisitRecord != null;

            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse" data-bs-target="#@collapseId">
                        <div class="d-flex justify-content-between align-items-center w-100 me-3">
                            <div>
                                <span style="font-weight:700;">@a.ScheduledDate.ToString("dd MMM yyyy")</span>
                                <span style="color:var(--text-mid);font-size:13px;margin-left:8px;">@a.SlotStartTime.ToString("HH\\:mm")</span>
                                <span style="margin-left:12px;font-size:13px;">@(a.Specialization?.Name ?? "—")</span>
                            </div>
                            <span class="badge @bc">@s</span>
                        </div>
                    </button>
                </h2>
                <div id="@collapseId" class="accordion-collapse collapse">
                    <div class="accordion-body">
                        @if (!string.IsNullOrWhiteSpace(a.ComplaintReason))
                        {
                            <div class="mb-3">
                                <div style="font-size:12px;color:var(--text-light);margin-bottom:4px;">Patient's Complaint</div>
                                <p style="font-size:14px;margin:0;">@a.ComplaintReason</p>
                            </div>
                        }

                        @if (hasVisitRec)
                        {
                            <div style="border-left:3px solid var(--success);padding-left:1rem;margin-bottom:1rem;">
                                <div style="font-size:12px;color:var(--text-light);margin-bottom:6px;">Visit Record</div>
                                @foreach (var (lbl, val) in new (string,string?)[] {
                                    ("Diagnosis", a.VisitRecord!.Diagnosis),
                                    ("Treatment", a.VisitRecord.Treatment),
                                    ("Notes",     a.VisitRecord.DoctorNotes),
                                })
                                {
                                    if (!string.IsNullOrWhiteSpace(val))
                                    {
                                        <div class="mb-2">
                                            <span style="font-weight:600;font-size:13px;">@lbl:</span>
                                            <span style="font-size:13px;color:var(--text-mid);"> @val</span>
                                        </div>
                                    }
                                }
                            </div>

                            @if (a.VisitRecord!.Prescriptions?.Any() == true)
                            {
                                <div style="border-left:3px solid var(--accent);padding-left:1rem;margin-bottom:1rem;">
                                    <div style="font-size:12px;color:var(--text-light);margin-bottom:6px;">Prescriptions</div>
                                    @foreach (var pres in a.VisitRecord.Prescriptions)
                                    {
                                        <div class="mb-2">
                                            <span style="font-weight:600;font-size:13px;">#@pres.PrescriptionId</span>
                                            <span style="font-size:12px;color:var(--text-light);"> — @pres.IssuedAt.ToString("dd MMM yyyy")</span>
                                            @if (pres.PrescriptionItems != null)
                                            {
                                                <ul style="margin:4px 0 0;padding-left:1.25rem;font-size:13px;">
                                                    @foreach (var item in pres.PrescriptionItems)
                                                    {
                                                        <li>
                                                            <strong>@item.MedicationName</strong> — @item.Dosage, @item.Frequency
                                                            @if (item.DurationDays.HasValue) { <span>for @item.DurationDays day(s)</span> }
                                                            @if (!string.IsNullOrWhiteSpace(item.Instructions))
                                                            { <em style="color:var(--text-light);display:block;font-size:12px;">@item.Instructions</em> }
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <p style="color:var(--text-light);font-size:13px;font-style:italic;">
                                No visit record (appointment not completed)
                            </p>
                        }

                        <a asp-action="AppointmentDetails" asp-route-id="@a.AppointmentId"
                           class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-eye me-1"></i> Open Appointment
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
