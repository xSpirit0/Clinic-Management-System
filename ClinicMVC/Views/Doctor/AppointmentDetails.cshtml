@model ClinicAPI.Models.Appointment
@{
    ViewData["Title"] = $"Appointment #{Model.AppointmentId}";
    var status = Model.AppointmentStatus.AppointmentStatus1;
    var bc = status switch {
        "Requested"  => "bg-secondary",
        "Confirmed"  => "bg-primary",
        "CheckedIn"  => "bg-info",
        "InProgress" => "bg-warning text-dark",
        "Completed"  => "bg-success",
        "Cancelled"  => "bg-danger",
        "Missed"     => "bg-dark",
        _            => "bg-secondary"
    };
    var canConfirm    = status == "Requested";
    var canCheckIn    = status == "Confirmed";
    var canStartVisit = status == "CheckedIn";
    var canComplete   = status == "InProgress";
    var canCancel     = status == "Requested" || status == "Confirmed" || status == "CheckedIn";
    var canMarkMissed = status == "Confirmed" || status == "CheckedIn";
    var hasVisitRec   = Model.VisitRecord != null;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="page-header mb-0">
        <h1>Appointment #@Model.AppointmentId</h1>
        <p>@Model.ScheduledDate.ToString("dddd, dd MMMM yyyy") · @Model.SlotStartTime.ToString("HH\\:mm") – @Model.SlotEndTime.ToString("HH\\:mm")</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="badge @bc" style="font-size:13px;padding:7px 14px;">@status</span>
        <a asp-action="MyAppointments" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">

        
        <div class="card mb-4">
            <div class="card-header"><i class="bi bi-person me-2"></i>Patient Information</div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var (lbl, val) in new (string,string)[] {
                        ("Name",       (Model.Patient?.AspNetUser?.FirstName ?? "—") + " " + (Model.Patient?.AspNetUser?.LastName ?? "")),
                        ("CPR Number", Model.Patient?.Cprnumber ?? "—"),
                        ("Date of Birth", Model.Patient?.DateOfBirth.ToString("dd MMM yyyy") ?? "—"),
                        ("Blood Type", Model.Patient?.BloodType ?? "—"),
                        ("Specialization", Model.Specialization?.Name ?? "—"),
                        ("Booked On", Model.CreatedAt.ToString("dd MMM yyyy, HH\\:mm")),
                    })
                    {
                        <div class="col-sm-6">
                            <div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">@lbl</div>
                            <div style="font-weight:500;font-size:14px;">@val</div>
                        </div>
                    }
                </div>
                <div class="mt-3">
                    <a asp-action="PatientHistory" asp-route-id="@Model.PatientId"
                       class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-clock-history me-1"></i> Full Medical History
                    </a>
                </div>
            </div>
        </div>

        
        @if (!string.IsNullOrWhiteSpace(Model.ComplaintReason))
        {
            <div class="card mb-4" style="border-left:4px solid var(--warning) !important;">
                <div class="card-body">
                    <div style="font-size:12px;color:var(--warning);font-weight:700;margin-bottom:4px;">
                        <i class="bi bi-exclamation-triangle me-1"></i> PATIENT'S COMPLAINT
                    </div>
                    <p style="font-size:14px;margin:0;">@Model.ComplaintReason</p>
                </div>
            </div>
        }

      
        @if (hasVisitRec)
        {
            <div class="card mb-4" style="border-left:4px solid var(--success) !important;">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-file-earmark-medical me-2"></i>Visit Record</span>
                    <a asp-action="WriteVisitRecord" asp-route-appointmentId="@Model.AppointmentId"
                       class="btn btn-sm btn-outline-success">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                </div>
                <div class="card-body">
                    <div style="font-size:12px;color:var(--text-light);margin-bottom:12px;">
                        Recorded on @Model.VisitRecord!.VisitDate.ToString("dd MMM yyyy, HH\\:mm")
                    </div>
                    @foreach (var (lbl, val) in new (string,string?)[] {
                        ("Diagnosis",      Model.VisitRecord.Diagnosis),
                        ("Treatment",      Model.VisitRecord.Treatment),
                        ("Doctor's Notes", Model.VisitRecord.DoctorNotes),
                    })
                    {
                        <div class="mb-3">
                            <div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">@lbl</div>
                            @if (string.IsNullOrWhiteSpace(val))
                            { <em style="color:var(--text-light);font-size:13px;">Not recorded</em> }
                            else
                            { <p style="font-size:14px;margin:0;">@val</p> }
                        </div>
                    }

                    <hr style="border-color:var(--border);" />
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span style="font-weight:600;font-size:14px;">
                            Prescriptions (@(Model.VisitRecord.Prescriptions?.Count ?? 0))
                        </span>
                        <a asp-action="AddPrescription" asp-route-visitRecordId="@Model.VisitRecord.VisitRecordId"
                           class="btn btn-sm btn-success">
                            <i class="bi bi-plus-circle me-1"></i> Add Prescription
                        </a>
                    </div>
                    @if (Model.VisitRecord.Prescriptions?.Any() == true)
                    {
                        @foreach (var pres in Model.VisitRecord.Prescriptions)
                        {
                            <div class="d-flex justify-content-between align-items-start py-2"
                                 style="border-bottom:1px solid var(--border);">
                                <div>
                                    <div style="font-weight:600;font-size:13px;">Prescription #@pres.PrescriptionId</div>
                                    <div style="font-size:12px;color:var(--text-light);">
                                        Issued @pres.IssuedAt.ToString("dd MMM yyyy") · @(pres.PrescriptionItems?.Count ?? 0) item(s)
                                        @if (pres.PrescriptionItems?.Any() == true)
                                        {
                                            <span> — @string.Join(", ", pres.PrescriptionItems.Select(i => i.MedicationName))</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
        else if (status == "InProgress" || status == "Completed")
        {
            <div class="alert alert-warning d-flex justify-content-between align-items-center">
                <div>
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>No visit record yet.</strong> Write notes, diagnosis, and treatment.
                </div>
                <a asp-action="WriteVisitRecord" asp-route-appointmentId="@Model.AppointmentId"
                   class="btn btn-warning ms-3">
                    <i class="bi bi-pencil me-1"></i> Write Record
                </a>
            </div>
        }

      
        @if (Model.AppointmentStatusHistories?.Any() == true)
        {
            <div class="card">
                <div class="card-header"><i class="bi bi-clock-history me-2"></i>Status History</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead><tr><th>Status</th><th>Changed At</th><th>Notes</th></tr></thead>
                            <tbody>
                                @foreach (var h in Model.AppointmentStatusHistories)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">@h.AppointmentStatus.AppointmentStatus1</span></td>
                                        <td style="font-size:13px;">@h.ChangedAt.ToString("dd MMM yyyy, HH\\:mm")</td>
                                        <td style="font-size:13px;color:var(--text-mid);">@(h.Notes ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>

  
    <div class="col-lg-4">
        <div class="card" style="position:sticky;top:80px;">
            <div class="card-header"><i class="bi bi-lightning me-2"></i>Lifecycle Actions</div>
            <div class="card-body d-flex flex-column gap-2">
                @if (canConfirm)
                {
                    <form asp-action="UpdateStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.AppointmentId" />
                        <input type="hidden" name="newStatus" value="Confirmed" />
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-check-circle me-1"></i> Confirm Appointment
                        </button>
                    </form>
                }
                @if (canCheckIn)
                {
                    <form asp-action="UpdateStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.AppointmentId" />
                        <input type="hidden" name="newStatus" value="CheckedIn" />
                        <button type="submit" class="btn btn-info text-white w-100">
                            <i class="bi bi-door-open me-1"></i> Check In Patient
                        </button>
                    </form>
                }
                @if (canStartVisit)
                {
                    <form asp-action="UpdateStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.AppointmentId" />
                        <input type="hidden" name="newStatus" value="InProgress" />
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-play-circle me-1"></i> Start Visit
                        </button>
                    </form>
                }
                @if (canComplete)
                {
                    <a asp-action="WriteVisitRecord" asp-route-appointmentId="@Model.AppointmentId"
                       class="btn btn-success w-100">
                        <i class="bi bi-check-all me-1"></i> Complete Visit (Write Record)
                    </a>
                }
                @if (canCancel)
                {
                    <button class="btn btn-outline-danger w-100" data-bs-toggle="modal" data-bs-target="#cancelModal">
                        <i class="bi bi-x-circle me-1"></i> Cancel Appointment
                    </button>
                }
                @if (canMarkMissed)
                {
                    <form asp-action="UpdateStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.AppointmentId" />
                        <input type="hidden" name="newStatus" value="Missed" />
                        <button type="submit" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-dash-circle me-1"></i> Mark as Missed
                        </button>
                    </form>
                }
                @if (!canConfirm && !canCheckIn && !canStartVisit && !canComplete && !canCancel && !canMarkMissed)
                {
                    <div class="text-center py-2" style="color:var(--text-light);font-size:13px;">
                        <i class="bi bi-lock me-1"></i> No further actions available
                    </div>
                }
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cancel Appointment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="UpdateStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.AppointmentId" />
                <input type="hidden" name="newStatus" value="Cancelled" />
                <div class="modal-body">
                    <label class="form-label">Reason for cancellation (optional)</label>
                    <textarea name="notes" class="form-control" rows="3"
                              placeholder="e.g. Doctor unavailable, patient requested reschedule…"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Keep</button>
                    <button type="submit" class="btn btn-danger">Confirm Cancellation</button>
                </div>
            </form>
        </div>
    </div>
</div>
